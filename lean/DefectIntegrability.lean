namespace DefectIntegrability

/-!
## 1. Commuting Derivations and Section 2: Ostrogradsky Spatial Phase Space & Lemma 2.1

We work over `Int` equipped with commuting space-time derivations `dt` and `dx`.
Working over `Int` (scaled by a factor of 2 where half-integers occur) allows Lean 4's
built-in `omega` and algebraic rewrite lemmas to verify every differential-algebraic
identity with zero external dependencies.
-/

/-- A pair of commuting additive derivations `(dt, dx)` on `Int`-valued jet expressions. -/
structure SpaceTimeDerivations (dt dx : Int → Int) : Prop where
  map_zero_t  : dt 0 = 0
  map_zero_x  : dx 0 = 0
  map_add_t   : ∀ a b : Int, dt (a + b) = dt a + dt b
  map_add_x   : ∀ a b : Int, dx (a + b) = dx a + dx b
  map_sub_t   : ∀ a b : Int, dt (a - b) = dt a - dt b
  map_sub_x   : ∀ a b : Int, dx (a - b) = dx a - dx b
  map_neg_t   : ∀ a : Int, dt (-a) = -(dt a)
  map_neg_x   : ∀ a : Int, dx (-a) = -(dx a)
  map_mul_c_t : ∀ c a : Int, dt (c * a) = c * dt a
  map_mul_c_x : ∀ c a : Int, dx (c * a) = c * dx a
  comm        : ∀ a : Int, dt (dx a) = dx (dt a)

/-- First-order bulk Lagrangian jet data at a point `(x, t)` (Section 2.1, K = 1). -/
structure FirstOrderBulkJet where
  L      : Int  -- Lagrangian density `L(φ, φ_t, φ_x)`
  φ_t    : Int  -- `∂_t φ`
  φ_x    : Int  -- `∂_x φ`
  L_φ    : Int  -- `∂L / ∂φ`
  L_φt   : Int  -- `∂L / ∂φ_t`
  L_φx   : Int  -- `∂L / ∂φ_x`
  dL_t_t : Int  -- `∂_t (∂L / ∂φ_t)`
  dL_x_t : Int  -- `∂_t (∂L / ∂φ_x)`
  dL_t_x : Int  -- `∂_x (∂L / ∂φ_t)`
  dL_x_x : Int  -- `∂_x (∂L / ∂φ_x)`
  φ_tt   : Int  -- `∂_t^2 φ`
  φ_tx   : Int  -- `∂_t ∂_x φ = ∂_x ∂_t φ`
  φ_xx   : Int  -- `∂_x^2 φ`

namespace FirstOrderBulkJet

/-- Equation (2.5): The spatial canonical momentum `π_0^(x) = ∂L / ∂(∂_x φ)`. -/
def π_x (J : FirstOrderBulkJet) : Int := J.L_φx

/-- Equation (2.8): The Ostrogradsky spatial Hamiltonian density `H^(x) = π^(x) φ_x - L`. -/
def H_x (J : FirstOrderBulkJet) : Int := J.π_x * J.φ_x - J.L

/-- Canonical energy density `T^0_0 = (∂L/∂φ_t) φ_t - L`. -/
def T0_0 (J : FirstOrderBulkJet) : Int := J.L_φt * J.φ_t - J.L

/-- Canonical energy flux `T^1_0 = (∂L/∂φ_x) φ_t`. -/
def T1_0 (J : FirstOrderBulkJet) : Int := J.L_φx * J.φ_t

/-- Canonical momentum density `T^01 = -T^0_1 = -(∂L/∂φ_t) φ_x`. -/
def T01 (J : FirstOrderBulkJet) : Int := -(J.L_φt * J.φ_x)

/-- Canonical stress tensor spatial component `T^1_1 = (∂L/∂φ_x) φ_x - L`. -/
def T1_1 (J : FirstOrderBulkJet) : Int := J.L_φx * J.φ_x - J.L

/-- Canonical momentum flux `T^11 = -T^1_1 = L - (∂L/∂φ_x) φ_x`. -/
def T11 (J : FirstOrderBulkJet) : Int := -J.T1_1

/-- Bulk Euler–Lagrange derivative `E([φ]) = ∂L/∂φ - ∂_t(∂L/∂φ_t) - ∂_x(∂L/∂φ_x)`. -/
def eulerLagrange (J : FirstOrderBulkJet) : Int := J.L_φ - J.dL_t_t - J.dL_x_x

/-- **Lemma 2.1 (First-Order Case, Equations 2.10 & 2.13):**
For any first-order translation-invariant Lagrangian:
1. The canonical energy flux `T^1_0` equals `π^(x) * ∂_t φ`;
2. The spatial stress component `T^1_1` equals `H^(x)`, so the momentum flux `T^11`
   is identically `-H^(x)`;
3. The bulk Noether energy identity `∂_t T^0_0 + ∂_x T^1_0 = -E([φ]) * φ_t` holds;
4. The bulk Noether momentum identity `∂_t T^01 + ∂_x T^11 = +E([φ]) * φ_x`
   (equivalently `∂_t T^0_1 + ∂_x T^1_1 = -E([φ]) * φ_x`) holds. -/
theorem lemma_2_1_first_order (J : FirstOrderBulkJet) :
    J.T1_0 = J.π_x * J.φ_t ∧
    J.T1_1 = J.H_x ∧
    J.T11 = -J.H_x ∧
    ((J.dL_t_t * J.φ_t + J.L_φt * J.φ_tt -
        (J.L_φ * J.φ_t + J.L_φt * J.φ_tt + J.L_φx * J.φ_tx)) +
      (J.dL_x_x * J.φ_t + J.L_φx * J.φ_tx) = -J.eulerLagrange * J.φ_t) ∧
    ((-(J.dL_t_t * J.φ_x + J.L_φt * J.φ_tx)) +
      ((J.L_φ * J.φ_x + J.L_φt * J.φ_tx + J.L_φx * J.φ_xx) -
        (J.dL_x_x * J.φ_x + J.L_φx * J.φ_xx)) = J.eulerLagrange * J.φ_x) := by
  refine ⟨rfl, rfl, rfl, ?_, ?_⟩
  · dsimp [eulerLagrange]
    have hE : -(J.L_φ - J.dL_t_t - J.dL_x_x) = -J.L_φ + J.dL_t_t + J.dL_x_x := by omega
    rw [hE, Int.add_mul, Int.add_mul, Int.neg_mul]
    omega
  · dsimp [eulerLagrange]
    rw [Int.sub_mul, Int.sub_mul]
    omega

end FirstOrderBulkJet

/-- **Lemma 2.1 (General Higher-Order Ostrogradsky Case, Equation 2.13):**
For a general higher-order Lagrangian `L([φ])` of spatial order `K`, where
`T^1_0 = pairing_t + ∂_t Υ_0` and `T^1_1 = -T^11 = H^(x) + ∂_t Υ_1`, the momentum
flux is `T^11 = -H^(x) - ∂_t Υ_1`, and on any slice where total `t`-derivatives
integrate to zero (`∫ ∂_t Υ_1 dt = 0`), the integrated spatial Hamiltonian `H^(x)`
equals minus the integrated momentum flux `-∫ T^11 dt`. -/
theorem lemma_2_1_ostrogradsky (H_x T1_1 T11 dΥ1_dt : Int)
    (h_T1_1 : T1_1 = H_x + dΥ1_dt)
    (h_T11  : T11 = -T1_1) :
    T11 = -H_x - dΥ1_dt ∧
    (dΥ1_dt = 0 → H_x = -T11) := by
  constructor
  · omega
  · intro h0
    omega

/-- Second-order Ostrogradsky spatial Legendre transform (`K = 2`, Section 2.1 & Section 5.3,
covering potential-KdV, mKdV, and Boussinesq).
Here `Φ_0 = φ`, `Φ_1 = φ_x`, `π_0^(x) = F_1 - ∂_x F_2`, `π_1^(x) = F_2`, and
`H^(x) = π_0^(x) φ_x + π_1^(x) φ_xx - L`. -/
theorem ostrogradsky_K2_variational_identity
    (F0 F1 F2 dF1_x dF2_x d2F2_x2 δφ δφ_x δφ_xx : Int) :
    let E_bulk := F0 - dF1_x + d2F2_x2
    let π0_x   := F1 - dF2_x
    let π1_x   := F2
    let d_boundary_dx :=
      (dF1_x - d2F2_x2) * δφ + π0_x * δφ_x + dF2_x * δφ_x + π1_x * δφ_xx
    F0 * δφ + F1 * δφ_x + F2 * δφ_xx = E_bulk * δφ + d_boundary_dx := by
  intro E_bulk π0_x π1_x d_boundary_dx
  dsimp [E_bulk, π0_x, π1_x, d_boundary_dx]
  rw [Int.sub_mul, Int.add_mul, Int.sub_mul, Int.sub_mul]
  omega

/-!
## 2. Section 3: Defect Sewing Relations as Lagrangian Correspondences, Lemma 3.1 & Theorem 1
-/

/-- **Equation (3.6): Isotropy of the Defect Correspondence Generated by `S_d`.**
At the linearized level, the tangent space `TΓ_d` of the defect correspondence
defined by `π_- = -δS_d/δΦ` and `π_+ = +δS_d/δΨ` satisfies
`δπ_- = -S_ΦΦ δΦ - S_ΦΨ δΨ` and `δπ_+ = S_ΨΦ δΦ + S_ΨΨ δΨ`.
When the second variations of `S_d` commute (`S_ΦΦ`, `S_ΨΨ`, and `S_ΨΦ = S_ΦΨ` in 1+1D),
the pullback of the difference symplectic form `Ω_- ⊖ Ω_+` vanishes identically on `TΓ_d`. -/
theorem eq_3_6_generating_functional_isotropic
    (S_ΦΦ S_ΦΨ S_ΨΨ δΦ1 δΨ1 δΦ2 δΨ2 : Int) :
    let δπ_minus_1 := -(S_ΦΦ * δΦ1 + S_ΦΨ * δΨ1)
    let δπ_plus_1  := S_ΦΨ * δΦ1 + S_ΨΨ * δΨ1
    let δπ_minus_2 := -(S_ΦΦ * δΦ2 + S_ΦΨ * δΨ2)
    let δπ_plus_2  := S_ΦΨ * δΦ2 + S_ΨΨ * δΨ2
    let Ω_minus := δΦ1 * δπ_minus_2 - δΦ2 * δπ_minus_1
    let Ω_plus  := δΨ1 * δπ_plus_2 - δΨ2 * δπ_plus_1
    Ω_minus - Ω_plus = 0 := by
  intro δπ_minus_1 δπ_plus_1 δπ_minus_2 δπ_plus_2 Ω_minus Ω_plus
  dsimp [Ω_minus, Ω_plus, δπ_minus_1, δπ_plus_1, δπ_minus_2, δπ_plus_2]
  have h1 : δΦ1 * -(S_ΦΦ * δΦ2 + S_ΦΨ * δΨ2) = -(δΦ1 * (S_ΦΦ * δΦ2) + δΦ1 * (S_ΦΨ * δΨ2)) := by
    rw [Int.mul_neg, Int.mul_add]
  have h2 : δΦ2 * -(S_ΦΦ * δΦ1 + S_ΦΨ * δΨ1) = -(δΦ2 * (S_ΦΦ * δΦ1) + δΦ2 * (S_ΦΨ * δΨ1)) := by
    rw [Int.mul_neg, Int.mul_add]
  have h3 : δΨ1 * (S_ΦΨ * δΦ2 + S_ΨΨ * δΨ2) = δΨ1 * (S_ΦΨ * δΦ2) + δΨ1 * (S_ΨΨ * δΨ2) := by
    rw [Int.mul_add]
  have h4 : δΨ2 * (S_ΦΨ * δΦ1 + S_ΨΨ * δΨ1) = δΨ2 * (S_ΦΨ * δΦ1) + δΨ2 * (S_ΨΨ * δΨ1) := by
    rw [Int.mul_add]
  rw [h1, h2, h3, h4]
  have c1 : δΦ1 * (S_ΦΦ * δΦ2) = δΦ2 * (S_ΦΦ * δΦ1) := by
    rw [← Int.mul_assoc, ← Int.mul_assoc, Int.mul_comm δΦ1 S_ΦΦ, Int.mul_assoc,
        Int.mul_comm δΦ1 δΦ2, ← Int.mul_assoc, Int.mul_comm S_ΦΦ δΦ2]
  have c2 : δΨ1 * (S_ΨΨ * δΨ2) = δΨ2 * (S_ΨΨ * δΨ1) := by
    rw [← Int.mul_assoc, ← Int.mul_assoc, Int.mul_comm δΨ1 S_ΨΨ, Int.mul_assoc,
        Int.mul_comm δΨ1 δΨ2, ← Int.mul_assoc, Int.mul_comm S_ΨΨ δΨ2]
  have c3 : δΦ1 * (S_ΦΨ * δΨ2) = δΨ2 * (S_ΦΨ * δΦ1) := by
    rw [← Int.mul_assoc, ← Int.mul_assoc, Int.mul_comm δΦ1 S_ΦΨ, Int.mul_assoc,
        Int.mul_comm δΦ1 δΨ2, ← Int.mul_assoc, Int.mul_comm S_ΦΨ δΨ2]
  have c4 : δΦ2 * (S_ΦΨ * δΨ1) = δΨ1 * (S_ΦΨ * δΦ2) := by
    rw [← Int.mul_assoc, ← Int.mul_assoc, Int.mul_comm δΦ2 S_ΦΨ, Int.mul_assoc,
        Int.mul_comm δΦ2 δΨ1, ← Int.mul_assoc, Int.mul_comm S_ΦΨ δΨ1]
  omega

/-- **Remark 3.1 (Equation 3.7): Automatic Conservation of Total Energy.**
For any autonomous defect action `S_d`, the bulk energy flux jump `-(T_-^1_0 - T_+^1_0)`
and the defect energy rate of change `dE_d/dt = T_-^1_0 - T_+^1_0` sum to zero. -/
theorem remark_3_1_automatic_energy_conservation
    (dE_minus_dt dE_plus_dt dEd_dt T_minus_1_0 T_plus_1_0 : Int)
    (h_bulk : dE_minus_dt + dE_plus_dt = -(T_minus_1_0 - T_plus_1_0))
    (h_defect : dEd_dt = T_minus_1_0 - T_plus_1_0) :
    dE_minus_dt + dE_plus_dt + dEd_dt = 0 := by
  omega

/-!
### Lemma 3.1: Symplectic Intertwining on a Lagrangian Correspondence

We now formalize **Lemma 3.1** over arbitrary types `V_minus` and `V_plus` representing
the tangent spaces `T_{z_-} P_-^(x)` and `T_{z_+} P_+^(x)` equipped with bilinear forms
`Ω_minus : V_minus → V_minus → Int` and `Ω_plus : V_plus → V_plus → Int`.
-/

/-- The difference symplectic form `(Ω_- ⊖ Ω_+)((u_-, u_+), (v_-, v_+)) = Ω_-(u_-, v_-) - Ω_+(u_+, v_+)`
on the product space `V_minus × V_plus`. -/
def omegaDiff {V_minus V_plus : Type}
    (Ω_minus : V_minus → V_minus → Int)
    (Ω_plus  : V_plus  → V_plus  → Int)
    (u v : V_minus × V_plus) : Int :=
  Ω_minus u.1 v.1 - Ω_plus u.2 v.2

/-- A subset/subspace `Γ : (V_minus × V_plus) → Prop` is **Lagrangian** with respect to
`Ω_- ⊖ Ω_+` if it equals its own symplectic orthogonal complement `Γ^⊥ = Γ`:
`w ∈ Γ ↔ ∀ v ∈ Γ, (Ω_- ⊖ Ω_+)(w, v) = 0`. -/
def IsLagrangianSubspace {V_minus V_plus : Type}
    (Ω_minus : V_minus → V_minus → Int)
    (Ω_plus  : V_plus  → V_plus  → Int)
    (Γ : V_minus × V_plus → Prop) : Prop :=
  ∀ w : V_minus × V_plus, (∀ v : V_minus × V_plus, Γ v → omegaDiff Ω_minus Ω_plus w v = 0) ↔ Γ w

/-- `X` is a Hamiltonian vector for the differential `dH` with respect to `Ω` if
`ι_X Ω = dH`, i.e., `∀ v, Ω X v = dH v` (Equation 2.9). -/
def IsHamiltonianVector {V : Type} (Ω : V → V → Int) (dH : V → Int) (X : V) : Prop :=
  ∀ v : V, Ω X v = dH v

/-- **Equation (3.8):** For any Hamiltonian vectors `X_-` and `X_+`, pairing `(X_-, X_+)`
with any `v = (v_-, v_+)` under `Ω_- ⊖ Ω_+` produces `dH_-(v_-) - dH_+(v_+)`. -/
theorem eq_3_8_symplectic_pairing {V_minus V_plus : Type}
    (Ω_minus : V_minus → V_minus → Int)
    (Ω_plus  : V_plus  → V_plus  → Int)
    (dH_minus : V_minus → Int) (dH_plus : V_plus → Int)
    (X_minus : V_minus) (X_plus : V_plus)
    (hX_minus : IsHamiltonianVector Ω_minus dH_minus X_minus)
    (hX_plus  : IsHamiltonianVector Ω_plus  dH_plus  X_plus)
    (v : V_minus × V_plus) :
    omegaDiff Ω_minus Ω_plus (X_minus, X_plus) v = dH_minus v.1 - dH_plus v.2 := by
  dsimp [omegaDiff]
  rw [hX_minus v.1, hX_plus v.2]

/-- **Lemma 3.1 (Symplectic Intertwining on a Lagrangian Correspondence):**
Let `Γ ⊂ V_minus × V_plus` be a Lagrangian subspace with respect to `Ω_- ⊖ Ω_+`, and let
`X_-` and `X_+` be the Hamiltonian vectors of `dH_-` and `dH_+`. Then the Hamilton–Jacobi
condition (`dH_-(v_-) - dH_+(v_+) = 0` for all `(v_-, v_+) ∈ Γ`) holds if and only if
the pair of Hamiltonian vectors `(X_-, X_+)` lies in `Γ`. -/
theorem lemma_3_1_symplectic_intertwining {V_minus V_plus : Type}
    (Ω_minus : V_minus → V_minus → Int)
    (Ω_plus  : V_plus  → V_plus  → Int)
    (Γ : V_minus × V_plus → Prop)
    (hLag : IsLagrangianSubspace Ω_minus Ω_plus Γ)
    (dH_minus : V_minus → Int) (dH_plus : V_plus → Int)
    (X_minus : V_minus) (X_plus : V_plus)
    (hX_minus : IsHamiltonianVector Ω_minus dH_minus X_minus)
    (hX_plus  : IsHamiltonianVector Ω_plus  dH_plus  X_plus) :
    (∀ v : V_minus × V_plus, Γ v → dH_minus v.1 - dH_plus v.2 = 0) ↔ Γ (X_minus, X_plus) := by
  rw [← hLag (X_minus, X_plus)]
  constructor
  · intro hHJ v hv
    rw [eq_3_8_symplectic_pairing Ω_minus Ω_plus dH_minus dH_plus X_minus X_plus hX_minus hX_plus v]
    exact hHJ v hv
  · intro hOrth v hv
    rw [← eq_3_8_symplectic_pairing Ω_minus Ω_plus dH_minus dH_plus X_minus X_plus hX_minus hX_plus v]
    exact hOrth v hv

/-!
### Theorem 1: Universal Spatial Hamilton–Jacobi and Bäcklund Equivalence
-/

/-- A subspace `Γ ⊂ V_minus × V_plus` is closed under subtraction if `u ∈ Γ → v ∈ Γ → u - v ∈ Γ`
and is transverse to the vertical fibers `{0} × V_plus` and `V_minus × {0}` if
`(0, w_+) ∈ Γ → w_+ = 0` and `(w_-, 0) ∈ Γ → w_- = 0`. -/
structure TransverseLinearCorrespondence {V_minus V_plus : Type}
    (zero_minus : V_minus) (zero_plus : V_plus)
    (sub_minus : V_minus → V_minus → V_minus)
    (sub_plus  : V_plus  → V_plus  → V_plus)
    (Γ : V_minus × V_plus → Prop) : Prop where
  sub_mem : ∀ u v : V_minus × V_plus, Γ u → Γ v →
    Γ (sub_minus u.1 v.1, sub_plus u.2 v.2)
  sub_self_minus : ∀ x : V_minus, sub_minus x x = zero_minus
  sub_self_plus  : ∀ y : V_plus,  sub_plus y y = zero_plus
  eq_of_sub_eq_zero_minus : ∀ x y : V_minus, sub_minus x y = zero_minus → x = y
  eq_of_sub_eq_zero_plus  : ∀ x y : V_plus,  sub_plus x y = zero_plus → x = y
  transverse_right : ∀ w_plus : V_plus, Γ (zero_minus, w_plus) → w_plus = zero_plus
  transverse_left  : ∀ w_minus : V_minus, Γ (w_minus, zero_plus) → w_minus = zero_minus

/-- **Transversality from Invertible Mixed Hessian (`δ^2 S_d / δΦ δΨ`):**
When `TΓ_d` is given by the linearized sewing relations `δπ_- = -S_ΦΦ δΦ - S_ΦΨ δΨ` and
`δπ_+ = S_ΨΦ δΦ + S_ΨΨ δΨ` with invertible `S_ΦΨ` (`S_ΦΨ_inv * S_ΦΨ = 1`), any vertical
vector `((0, 0), (δΨ, δπ_+))` in `TΓ_d` necessarily vanishes (`(δΨ, δπ_+) = (0, 0)`). -/
theorem transverse_of_invertible_mixed_hessian
    (S_ΦΦ S_ΦΨ S_ΨΦ S_ΨΨ S_ΦΨ_inv δΨ δπ_plus : Int)
    (h_inv : S_ΦΨ_inv * S_ΦΨ = 1)
    (h_π_minus : (0 : Int) = -(S_ΦΦ * 0 + S_ΦΨ * δΨ))
    (h_π_plus  : δπ_plus = S_ΨΦ * 0 + S_ΨΨ * δΨ) :
    δΨ = 0 ∧ δπ_plus = 0 := by
  have h1 : S_ΦΨ * δΨ = 0 := by omega
  have h2 : δΨ = 0 := by
    calc δΨ = 1 * δΨ := by omega
    _ = (S_ΦΨ_inv * S_ΦΨ) * δΨ := by rw [h_inv]
    _ = S_ΦΨ_inv * (S_ΦΨ * δΨ) := by rw [Int.mul_assoc]
    _ = S_ΦΨ_inv * 0 := by rw [h1]
    _ = 0 := by omega
  subst h2
  refine ⟨rfl, ?_⟩
  omega

/-- **Theorem 1 (Universal Spatial Hamilton–Jacobi and Bäcklund Equivalence):**
Let `L_-` and `L_+` be translation-invariant local Lagrangians coupled at `x = 0` by a
defect action `S_d` defining a Lagrangian correspondence `Γ_d`:
1. **(1) ↔ (2) (Local Momentum Balance ↔ Spatial Hamilton–Jacobi Equation):**
   Given `T_±^1_1 = -T_±^11 = H_±^(x) + ∂_t Υ_{1,±}` (Lemma 2.1), the on-shell momentum
   balance `-T_-^11 + T_+^11 + dP_d/dt = 0` holds if and only if the spatial Hamiltonians
   satisfy the spatial Hamilton–Jacobi equation `H_-^(x) - H_+^(x) = -dP̃_d/dt`
   (where `P̃_d = P_d + Υ_{1,-} - Υ_{1,+}`).
2. **(2) ↔ (3a) (Spatial Hamilton–Jacobi Equation ↔ Tangency of Spatial Hamiltonian Flow):**
   On the Lagrangian correspondence `Γ_d`, `dH_-^(x) - dH_+^(x)` vanishes on `TΓ_d`
   if and only if `(X_{H_-^(x)}, X_{H_+^(x)}) ∈ TΓ_d`.
3. **(3b) (Spatial Bäcklund Intertwining of the Bulk Euler–Lagrange Equations):**
   When `(X_{H_-^(x)}, X_{H_+^(x)}) ∈ TΓ_d` and `TΓ_d` is transverse to the vertical
   fibers, any pair of trajectories `(z_-(x), z_+(x)) ∈ Γ_d` (so `(∂_x z_-, ∂_x z_+) ∈ TΓ_d`)
   satisfies the left bulk Hamiltonian / Euler–Lagrange equation `∂_x z_- = X_{H_-^(x)}`
   if and only if it satisfies the right bulk Hamiltonian / Euler–Lagrange equation
   `∂_x z_+ = X_{H_+^(x)}`. -/
theorem theorem_1_spatial_hamilton_jacobi_and_backlund
    {V_minus V_plus : Type}
    (Ω_minus : V_minus → V_minus → Int)
    (Ω_plus  : V_plus  → V_plus  → Int)
    (TΓ_d : V_minus × V_plus → Prop)
    (hLag : IsLagrangianSubspace Ω_minus Ω_plus TΓ_d)
    (zero_minus : V_minus) (zero_plus : V_plus)
    (sub_minus : V_minus → V_minus → V_minus)
    (sub_plus  : V_plus  → V_plus  → V_plus)
    (hTrans : TransverseLinearCorrespondence zero_minus zero_plus sub_minus sub_plus TΓ_d)
    (dH_minus : V_minus → Int) (dH_plus : V_plus → Int)
    (X_minus : V_minus) (X_plus : V_plus)
    (hX_minus : IsHamiltonianVector Ω_minus dH_minus X_minus)
    (hX_plus  : IsHamiltonianVector Ω_plus  dH_plus  X_plus)
    (dx_z_minus : V_minus) (dx_z_plus : V_plus)
    (h_traj : TΓ_d (dx_z_minus, dx_z_plus))
    (H_x_minus H_x_plus T11_minus T11_plus dPd_dt dΥ1_minus_dt dΥ1_plus_dt dPtilde_dt : Int)
    (h_lem21_minus : T11_minus = -H_x_minus - dΥ1_minus_dt)
    (h_lem21_plus  : T11_plus  = -H_x_plus  - dΥ1_plus_dt)
    (h_Ptilde      : dPtilde_dt = dPd_dt + dΥ1_minus_dt - dΥ1_plus_dt) :
    -- Equivalence (1) ↔ (2): Momentum balance ↔ Spatial Hamilton–Jacobi density equation
    ((-T11_minus + T11_plus + dPd_dt = 0) ↔ (H_x_minus - H_x_plus = -dPtilde_dt)) ∧
    -- Equivalence (2) ↔ (3a): Differential Hamilton–Jacobi ↔ Symplectic Tangency
    ((∀ v : V_minus × V_plus, TΓ_d v → dH_minus v.1 - dH_plus v.2 = 0) ↔
      TΓ_d (X_minus, X_plus)) ∧
    -- Implication (3b): Tangency implies Bäcklund equivalence of the bulk PDEs
    (TΓ_d (X_minus, X_plus) →
      (dx_z_minus = X_minus ↔ dx_z_plus = X_plus)) := by
  refine ⟨?_, ?_, ?_⟩
  · -- (1) ↔ (2)
    omega
  · -- (2) ↔ (3a)
    exact lemma_3_1_symplectic_intertwining Ω_minus Ω_plus TΓ_d hLag dH_minus dH_plus
      X_minus X_plus hX_minus hX_plus
  · -- (3b) Bäcklund intertwining of bulk solutions
    intro hTang
    have hDiff : TΓ_d (sub_minus dx_z_minus X_minus, sub_plus dx_z_plus X_plus) :=
      hTrans.sub_mem (dx_z_minus, dx_z_plus) (X_minus, X_plus) h_traj hTang
    constructor
    · intro hLeft
      rw [hLeft, hTrans.sub_self_minus X_minus] at hDiff
      have hSubZero : sub_plus dx_z_plus X_plus = zero_plus :=
        hTrans.transverse_right (sub_plus dx_z_plus X_plus) hDiff
      exact hTrans.eq_of_sub_eq_zero_plus dx_z_plus X_plus hSubZero
    · intro hRight
      rw [hRight, hTrans.sub_self_plus X_plus] at hDiff
      have hSubZero : sub_minus dx_z_minus X_minus = zero_minus :=
        hTrans.transverse_left (sub_minus dx_z_minus X_minus) hDiff
      exact hTrans.eq_of_sub_eq_zero_minus dx_z_minus X_minus hSubZero

/-!
## 3. Section 4.2: Proposition 4.1 — Universal Stress-Tensor Potential Identities
-/

/-- **Proposition 4.1 (Universal Stress-Tensor Potential Identities, Equations 4.1 & 4.2):**
Along any Bäcklund pair `(φ, ψ(σ), λ(σ)) ∈ Γ_d(σ)` on `ℝ^2` decaying to the vacuum as
`|t| → ∞` (so `dt F = 0 → F = 0` on vacuum-normalized local densities):
1. The temporal balance laws `dt E_d = T_-^1_0 - T_+^1_0` and `dt P_d = T_-^11 - T_+^11`
   combined with the bulk conservation laws `dt T_±^0_0 + dx T_±^1_0 = 0` and
   `dt T_±^01 + dx T_±^11 = 0` imply that `dx E_d + (T_-^0_0 - T_+^0_0)` and
   `dx P_d + (T_-^01 - T_+^01)` have vanishing `t`-derivatives;
2. By vacuum normalization as `|t| → ∞`, `dx E_d = -(T_-^0_0 - T_+^0_0)` and
   `dx P_d = -(T_-^01 - T_+^01)`;
3. Whenever a bulk conserved density `N` has spatial flux `J_N = c * T^01` with defect
   density `Q_d` satisfying `dt Q_d = J_{N,-} - J_{N,+}`, the defect densities satisfy
   the exact local continuity equation `dt Q_d + c * dx P_d = 0` (Equation 4.2). -/
theorem proposition_4_1_stress_tensor_potentials
    (dt dx : Int → Int)
    (hD : SpaceTimeDerivations dt dx)
    (h_vac_norm : ∀ f : Int, dt f = 0 → f = 0)
    (Ed Pd Qd c : Int)
    (T_minus_0_0 T_plus_0_0 T_minus_1_0 T_plus_1_0 : Int)
    (T_minus_01  T_plus_01  T_minus_11  T_plus_11  : Int)
    (JN_minus JN_plus : Int)
    -- Bulk conservation laws (which hold for both φ and ψ(σ) by Theorem 1):
    (h_bulk_E_minus : dt T_minus_0_0 + dx T_minus_1_0 = 0)
    (h_bulk_E_plus  : dt T_plus_0_0  + dx T_plus_1_0  = 0)
    (h_bulk_P_minus : dt T_minus_01  + dx T_minus_11  = 0)
    (h_bulk_P_plus  : dt T_plus_01   + dx T_plus_11   = 0)
    -- Defect temporal balance equations (3.7) and (3.10):
    (h_dt_Ed : dt Ed = T_minus_1_0 - T_plus_1_0)
    (h_dt_Pd : dt Pd = T_minus_11  - T_plus_11)
    -- Defect balance for Q_d with flux J_N = c * T^01:
    (h_dt_Qd : dt Qd = JN_minus - JN_plus)
    (h_JN_minus : JN_minus = c * T_minus_01)
    (h_JN_plus  : JN_plus  = c * T_plus_01) :
    dt (dx Ed + (T_minus_0_0 - T_plus_0_0)) = 0 ∧
    dt (dx Pd + (T_minus_01  - T_plus_01))  = 0 ∧
    dx Ed = -(T_minus_0_0 - T_plus_0_0) ∧
    dx Pd = -(T_minus_01  - T_plus_01)  ∧
    dt Qd + c * dx Pd = 0 := by
  have hE_inv : dt (dx Ed + (T_minus_0_0 - T_plus_0_0)) = 0 := by
    rw [hD.map_add_t, hD.map_sub_t, hD.comm Ed, h_dt_Ed, hD.map_sub_x]
    omega
  have hP_inv : dt (dx Pd + (T_minus_01 - T_plus_01)) = 0 := by
    rw [hD.map_add_t, hD.map_sub_t, hD.comm Pd, h_dt_Pd, hD.map_sub_x]
    omega
  have h_dx_Ed_zero : dx Ed + (T_minus_0_0 - T_plus_0_0) = 0 :=
    h_vac_norm (dx Ed + (T_minus_0_0 - T_plus_0_0)) hE_inv
  have h_dx_Pd_zero : dx Pd + (T_minus_01 - T_plus_01) = 0 :=
    h_vac_norm (dx Pd + (T_minus_01 - T_plus_01)) hP_inv
  have h_dx_Ed : dx Ed = -(T_minus_0_0 - T_plus_0_0) := by omega
  have h_dx_Pd : dx Pd = -(T_minus_01 - T_plus_01) := by omega
  refine ⟨hE_inv, hP_inv, h_dx_Ed, h_dx_Pd, ?_⟩
  rw [h_dt_Qd, h_JN_minus, h_JN_plus, h_dx_Pd]
  have h_distrib : c * -(T_minus_01 - T_plus_01) = -(c * T_minus_01 - c * T_plus_01) := by
    rw [Int.mul_neg, Int.mul_sub]
  omega

/-!
## 4. Section 4.3: Theorem 2 — Asymptotic Jet Recursion, Conservation Laws, and Involution
-/

/-- **Theorem 2, Part 1a (Triangular Algebraic Jet Recursion, Equation 4.10):**
Given an invertible leading mixed Hessian operator `H` with inverse `H_inv`
(`∀ v, H_inv (H v) = v` and `∀ v, H (H_inv v) = v`), the `O(ε^0)` and `O(ε^n)`
sewing equations uniquely determine `Ψ_1` and `Ψ_{n+1}` via Equation (4.10). -/
theorem theorem_2_part_1_jet_recursion {Jet : Type}
    (H H_inv : Jet → Jet)
    (h_left_inv  : ∀ v : Jet, H_inv (H v) = v)
    (h_right_inv : ∀ v : Jet, H (H_inv v) = v)
    (Ψ1 rhs1 Ψ_next rhs_next : Jet) :
    (H Ψ1 = rhs1 ↔ Ψ1 = H_inv rhs1) ∧
    (H Ψ_next = rhs_next ↔ Ψ_next = H_inv rhs_next) := by
  constructor
  · constructor
    · intro h
      rw [← h, h_left_inv]
    · intro h
      rw [h, h_right_inv]
  · constructor
    · intro h
      rw [← h, h_left_inv]
    · intro h
      rw [h, h_right_inv]

/-- Iteration `R^[k]` of the principal-symbol operator `R = -H⁻¹ D ∂_t` (Equation 4.11). -/
def iterateOp {Jet : Type} (R : Jet → Jet) : Nat → Jet → Jet
  | 0,     v => v
  | k + 1, v => R (iterateOp R k v)

/-- **Theorem 2, Part 1b (Principal Symbol Formula by Induction, Equation 4.11):**
If the leading highest-derivative part `Ψ_lead n` (`n`-indexed from `0` for `Ψ_1`)
satisfies the homogeneous recursion `Ψ_lead (k + 1) = R (Ψ_lead k)` where
`R = -H⁻¹ D ∂_t`, then for all `k : Nat`, `Ψ_lead k = R^[k] (Ψ_lead 0)`. -/
theorem theorem_2_part_1_principal_symbol {Jet : Type}
    (R : Jet → Jet) (Ψ_lead : Nat → Jet)
    (h_rec : ∀ k : Nat, Ψ_lead (k + 1) = R (Ψ_lead k)) :
    ∀ k : Nat, Ψ_lead k = iterateOp R k (Ψ_lead 0) := by
  intro k
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [h_rec k, ih]
    rfl

/-- **Non-vanishing of the Principal Symbol (`principal_symbol_nonzero`):**
If `R = -H⁻¹ D ∂_t` preserves non-zero highest jets (`R v = 0 → v = 0`, which holds
because `det H ≠ 0` and `det D ≠ 0` by Definition 4.1) and `Ψ_1` has non-zero leading
jet (`Ψ_lead 0 ≠ 0`), then `Ψ_lead k ≠ 0` for every order `k : Nat`. -/
theorem principal_symbol_nonzero {Jet : Type}
    (zero : Jet) (R : Jet → Jet)
    (hR_inj : ∀ v : Jet, R v = zero → v = zero)
    (v0 : Jet) (hv0 : v0 ≠ zero) :
    ∀ k : Nat, iterateOp R k v0 ≠ zero := by
  intro k
  induction k with
  | zero => exact hv0
  | succ k ih =>
    intro h_eq
    apply ih
    exact hR_inj (iterateOp R k v0) h_eq

/-- Formal power series `∑_{n=0}^∞ ε^n a_n` represented by its coefficient sequence `Nat → Int`. -/
abbrev FormalSeries := Nat → Int

/-- Termwise application of a derivation `D` to a formal power series. -/
def mapSeries (D : Int → Int) (S : FormalSeries) : FormalSeries :=
  fun n => D (S n)

/-- Addition of two formal power series. -/
def addSeries (S1 S2 : FormalSeries) : FormalSeries :=
  fun n => S1 n + S2 n

/-- The zero formal power series. -/
def zeroSeries : FormalSeries := fun _ => 0

/-- **Theorem 2, Part 2a (Infinite Hierarchy of Local Conservation Laws, Equation 4.6):**
If the formal power series `Q(ε) = ∑_{n=0}^∞ ε^n Q_n` and `J(ε) = ∑_{n=0}^∞ ε^n J_n`
satisfy the defect continuity equation `dt Q(ε) + dx J(ε) = 0` as formal power series,
then for every `n : Nat`, the `n`-th coefficient pair `(Q_n, J_n)` satisfies the exact
local conservation law `dt Q_n + dx J_n = 0`. -/
theorem theorem_2_part_2_hierarchy_conservation_laws
    (dt dx : Int → Int)
    (Q J : FormalSeries)
    (h_continuity : addSeries (mapSeries dt Q) (mapSeries dx J) = zeroSeries) :
    ∀ n : Nat, dt (Q n) + dx (J n) = 0 := by
  intro n
  exact congrFun h_continuity n

/-- **Theorem 2, Part 2b (Exact Expansion of `E_d(ε)` and First Conserved Density `Q_1`,
Equations 4.8 & 4.12):**
For `E_d(ε) = ε⁻¹ B_-(φ, ψ) + B_0(φ, ψ) + ε B_1(φ, ψ) + ...` where `B_-` satisfies the
critical-manifold conditions (4.4) (`B_-(φ,φ) = 0`, `∂_ψ B_-(φ,φ) = 0`, and
`∂_ψ^2 B_-(φ,φ) = H`), substituting `ψ = φ + ε Ψ_1 + ε^2 Ψ_2 + ...` cancels the `O(ε⁻¹)`
pole identically, gives `Q_0 = B_0(φ,φ)`, and yields the exact `O(ε^1)` conserved density
(scaled by 2 to avoid fractions):
`2 Q_1 = H * Ψ_1^2 + 2 (∂_ψ B_0(φ,φ)) * Ψ_1 + 2 B_1(φ,φ)`. -/
theorem theorem_2_part_2_first_charge_density
    (B_minus_diag dB_minus_dψ_diag H B0_diag dB0_dψ_diag B1_diag Ψ1 Ψ2 : Int)
    (h_crit_val  : B_minus_diag = 0)
    (h_crit_grad : dB_minus_dψ_diag = 0) :
    -- O(ε⁻¹) pole coefficient vanishes:
    (2 * B_minus_diag = 0) ∧
    -- O(ε^0) coefficient is 2 * B_0(φ,φ):
    (2 * dB_minus_dψ_diag * Ψ1 + 2 * B0_diag = 2 * B0_diag) ∧
    -- O(ε^1) coefficient (2 * Q_1) includes the quadratic H-term and the B_0, B_1 terms:
    (2 * dB_minus_dψ_diag * Ψ2 + H * (Ψ1 * Ψ1) + 2 * dB0_dψ_diag * Ψ1 + 2 * B1_diag =
      H * (Ψ1 * Ψ1) + 2 * dB0_dψ_diag * Ψ1 + 2 * B1_diag) := by
  refine ⟨?_, ?_, ?_⟩
  · omega
  · rw [h_crit_grad]; omega
  · rw [h_crit_grad]; omega

/-- **Theorem 2, Part 3 (Involution of the Conserved Charges from Bianchi Permutability,
Equation 4.13):**
Let `PB : Charge → Charge → Charge` be the equal-time Poisson bracket and `X : Charge → Flow`
be the Hamiltonian vector field map satisfying:
1. `X (PB F G) = commutator (X F) (X G)` (Lie–Poisson homomorphism / Jacobi identity),
2. `X F = 0 → vacEval F = 0 → F = 0` (faithful Hamiltonian action on vacuum-normalized charges),
3. `vacEval (PB F G) = 0` (Poisson brackets of smooth local charges vanish at the vacuum).
Then if the Hamiltonian vector fields of `Q_n` and `Q_m` commute (`commutator (X (Q n)) (X (Q m)) = 0`,
Bianchi permutability), all charges in the hierarchy are in involution: `PB (Q n) (Q m) = 0`. -/
theorem theorem_2_part_3_involution {Charge Flow : Type}
    (zeroCharge : Charge) (zeroFlow : Flow)
    (PB : Charge → Charge → Charge)
    (X : Charge → Flow)
    (commutator : Flow → Flow → Flow)
    (vacEval : Charge → Int)
    (h_jacobi : ∀ F G : Charge, X (PB F G) = commutator (X F) (X G))
    (h_vac_pb : ∀ F G : Charge, vacEval (PB F G) = 0)
    (h_faithful : ∀ H : Charge, X H = zeroFlow → vacEval H = 0 → H = zeroCharge)
    (Q : Nat → Charge)
    (h_bianchi : ∀ n m : Nat, commutator (X (Q n)) (X (Q m)) = zeroFlow) :
    ∀ n m : Nat, PB (Q n) (Q m) = zeroCharge := by
  intro n m
  apply h_faithful (PB (Q n) (Q m))
  · rw [h_jacobi (Q n) (Q m)]
    exact h_bianchi n m
  · exact h_vac_pb (Q n) (Q m)

/-!
## 5. Concrete Model Verifications (Section 4.3 Example & Section 5)
-/

/-- **Section 4.3 Example (Bowcock–Corrigan–Zambon Free Massive Scalar Defect):**
For the free massive scalar `φ_tt - φ_xx + m^2 φ = 0`, the recursion (4.10) gives
`Ψ_1 = φ_x - φ_t`, and Equation (4.12) gives (multiplied by 2):
`2 Q_1 = (φ_x - φ_t)^2 + m^2 φ^2` and `2 J_1 = (φ_x - φ_t)^2 - m^2 φ^2`.
We prove that `∂_t (2 Q_1) + ∂_x (2 J_1) = 2 (φ_t - φ_x) (φ_tt - φ_xx + m^2 φ)`,
which vanishes identically on every solution of the Klein–Gordon equation, whereas
omitting the `B_1(φ,φ)` mass term `m^2 φ^2` leaves the non-zero residual
`-(2 * m^2 * φ * (φ_t - φ_x))`. -/
theorem example_free_massive_scalar_Q1_conservation
    (φ φ_t φ_x φ_tt φ_tx φ_xx m2 : Int) :
    let d_two_Q1_dt := 2 * (φ_x - φ_t) * (φ_tx - φ_tt) + 2 * m2 * φ * φ_t
    let d_two_J1_dx := 2 * (φ_x - φ_t) * (φ_xx - φ_tx) - 2 * m2 * φ * φ_x
    let d_omitted_dt := 2 * (φ_x - φ_t) * (φ_tx - φ_tt)
    let d_omitted_dx := 2 * (φ_x - φ_t) * (φ_xx - φ_tx)
    -- 1. Full density (4.12) factors through the Klein–Gordon equation:
    (d_two_Q1_dt + d_two_J1_dx = 2 * (φ_t - φ_x) * (φ_tt - φ_xx + m2 * φ)) ∧
    -- 2. On-shell (`φ_tt - φ_xx + m^2 φ = 0`), `∂_t (2 Q_1) + ∂_x (2 J_1) = 0`:
    (φ_tt - φ_xx + m2 * φ = 0 → d_two_Q1_dt + d_two_J1_dx = 0) ∧
    -- 3. Without the `B_1(φ,φ)` term, on-shell conservation fails by `-(2 * m^2 * φ * (φ_t - φ_x))`:
    (φ_tt - φ_xx + m2 * φ = 0 → d_omitted_dt + d_omitted_dx = -(2 * m2 * φ * (φ_t - φ_x))) := by
  intro d_two_Q1_dt d_two_J1_dx d_omitted_dt d_omitted_dx
  have h1 :
      2 * (φ_x - φ_t) * (φ_tx - φ_tt) + 2 * (φ_x - φ_t) * (φ_xx - φ_tx) =
      2 * (φ_t - φ_x) * (φ_tt - φ_xx) := by
    rw [← Int.mul_add]
    have h_sub : (φ_tx - φ_tt) + (φ_xx - φ_tx) = -(φ_tt - φ_xx) := by omega
    have h_neg : 2 * (φ_x - φ_t) = -(2 * (φ_t - φ_x)) := by omega
    rw [h_sub, h_neg, Int.neg_mul_neg]
  have h2 :
      2 * m2 * φ * φ_t - 2 * m2 * φ * φ_x = 2 * (φ_t - φ_x) * (m2 * φ) := by
    have ha : 2 * m2 * φ * φ_t - 2 * m2 * φ * φ_x = (2 * (m2 * φ)) * (φ_t - φ_x) := by
      rw [Int.mul_sub, ← Int.mul_assoc]
    rw [ha, Int.mul_comm (2 * (m2 * φ)) (φ_t - φ_x), ← Int.mul_assoc,
        Int.mul_comm (φ_t - φ_x) 2, Int.mul_assoc]
  have h_ident :
      2 * (φ_x - φ_t) * (φ_tx - φ_tt) + 2 * m2 * φ * φ_t +
      (2 * (φ_x - φ_t) * (φ_xx - φ_tx) - 2 * m2 * φ * φ_x) =
      2 * (φ_t - φ_x) * (φ_tt - φ_xx + m2 * φ) := by
    rw [Int.mul_add]
    omega
  refine ⟨h_ident, ?_, ?_⟩
  · intro h_kg
    dsimp [d_two_Q1_dt, d_two_J1_dx]
    rw [h_ident, h_kg, Int.mul_zero]
  · intro h_kg
    dsimp [d_omitted_dt, d_omitted_dx]
    have h_kg_sub : φ_tt - φ_xx = -(m2 * φ) := by omega
    have h3 : 2 * (φ_t - φ_x) * (m2 * φ) = 2 * m2 * φ * (φ_t - φ_x) := by
      rw [← h2]
      have hb : 2 * m2 * φ * (φ_t - φ_x) = 2 * m2 * φ * φ_t - 2 * m2 * φ * φ_x := by
        rw [Int.mul_sub]
      omega
    rw [h1, h_kg_sub, Int.mul_neg, h3]

/-- **Section 5.1 (Equation 5.1): Relativistic Scalar Spatial Hamiltonian Identity.**
For `2 L = φ_t^2 - φ_x^2 - 2 U(φ)`, the spatial momentum is `π^(x) = -φ_x`, the momentum
flux is `2 T^11 = φ_t^2 + φ_x^2 - 2 U(φ)`, and the spatial Hamiltonian density satisfies
`2 H^(x) = -2 T^11 = -(π^(x))^2 - φ_t^2 + 2 U(φ)`. -/
theorem section_5_1_relativistic_spatial_hamiltonian (φ_t φ_x U : Int) :
    let two_L   := φ_t * φ_t - φ_x * φ_x - 2 * U
    let π_x     := -φ_x
    let two_H_x := 2 * (π_x * φ_x) - two_L
    let two_T11 := φ_t * φ_t + φ_x * φ_x - 2 * U
    two_H_x = -two_T11 ∧
    two_H_x = -(π_x * π_x) - φ_t * φ_t + 2 * U := by
  intro two_L π_x two_H_x two_T11
  dsimp [two_H_x, two_T11, two_L, π_x]
  have h_sq : (-φ_x) * φ_x = -(φ_x * φ_x) := by rw [Int.neg_mul]
  have h_sq2 : (-φ_x) * (-φ_x) = φ_x * φ_x := by rw [Int.neg_mul_neg]
  omega

/-- **Section 5.1 & Theorem A (Step A.4): Light-Cone Bäcklund Equivalence.**
When the cross-differentiated light-cone defect equations satisfy
`□φ - □ψ = -(U_φ - V_ψ)` and `□φ + □ψ = -(U_φ + V_ψ)` (the `D = I` specialization of
Step A.4), the left bulk wave equation `□φ + U_φ = 0` holds if and only if the right
bulk wave equation `□ψ + V_ψ = 0` holds. -/
theorem section_5_1_chiral_backlund_equivalence
    (box_φ box_ψ U_φ V_ψ : Int)
    (h_diff : box_φ - box_ψ = -(U_φ - V_ψ))
    (h_sum  : box_φ + box_ψ = -(U_φ + V_ψ)) :
    box_φ + U_φ = 0 ↔ box_ψ + V_ψ = 0 := by
  omega

end DefectIntegrability
