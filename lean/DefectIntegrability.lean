namespace DefectIntegrability

/-!
## 1. Commuting Leibniz Derivations and Section 2: Ostrogradsky Spatial Phase Space & Lemma 2.1

We axiomatize a pair of commuting derivations `(dt, dx)` satisfying additivity and the
**Leibniz product rule** `dt (a * b) = dt a * b + a * dt b`. Unlike `Int`-linear maps
(which would degenerate to multiplication by `dt 1`), a Leibniz derivation automatically
satisfies `dt 1 = 0` and `dt (c * a) = c * dt a` whenever `dt c = 0`.
-/

/-- A pair of commuting additive derivations `(dt, dx)` satisfying the Leibniz product rule. -/
structure SpaceTimeDerivations (dt dx : Int → Int) : Prop where
  map_add_t : ∀ a b : Int, dt (a + b) = dt a + dt b
  map_add_x : ∀ a b : Int, dx (a + b) = dx a + dx b
  map_sub_t : ∀ a b : Int, dt (a - b) = dt a - dt b
  map_sub_x : ∀ a b : Int, dx (a - b) = dx a - dx b
  map_neg_t : ∀ a : Int, dt (-a) = -(dt a)
  map_neg_x : ∀ a : Int, dx (-a) = -(dx a)
  leibniz_t : ∀ a b : Int, dt (a * b) = dt a * b + a * dt b
  leibniz_x : ∀ a b : Int, dx (a * b) = dx a * b + a * dx b
  comm      : ∀ a : Int, dt (dx a) = dx (dt a)

namespace SpaceTimeDerivations

theorem leibniz_x' {dt dx : Int → Int} (hD : SpaceTimeDerivations dt dx) (a b : Int) :
    dx (a * b) = dx a * b + a * dx b :=
  hD.leibniz_x a b

/-- Every Leibniz derivation maps `0` to `0`. -/
theorem map_zero_t {dt dx : Int → Int} (hD : SpaceTimeDerivations dt dx) : dt 0 = 0 := by
  have h := hD.map_sub_t 0 0
  have hz : (0 : Int) - 0 = 0 := rfl
  rw [hz] at h
  omega

theorem map_zero_x {dt dx : Int → Int} (hD : SpaceTimeDerivations dt dx) : dx 0 = 0 := by
  have h := hD.map_sub_x 0 0
  have hz : (0 : Int) - 0 = 0 := rfl
  rw [hz] at h
  omega

/-- Every Leibniz derivation maps `1` to `0` (`dt (1 * 1) = dt 1 * 1 + 1 * dt 1`). -/
theorem map_one_t {dt dx : Int → Int} (hD : SpaceTimeDerivations dt dx) : dt 1 = 0 := by
  have h := hD.leibniz_t 1 1
  have h1 : (1 : Int) * 1 = 1 := rfl
  rw [h1, Int.mul_one, Int.one_mul] at h
  omega

theorem map_one_x {dt dx : Int → Int} (hD : SpaceTimeDerivations dt dx) : dx 1 = 0 := by
  have h := hD.leibniz_x 1 1
  have h1 : (1 : Int) * 1 = 1 := rfl
  rw [h1, Int.mul_one, Int.one_mul] at h
  omega

/-- Constant-multiple rule derived from the Leibniz rule whenever `dt c = 0`. -/
theorem map_const_mul_t {dt dx : Int → Int} (hD : SpaceTimeDerivations dt dx)
    (c a : Int) (hc : dt c = 0) : dt (c * a) = c * dt a := by
  rw [hD.leibniz_t c a, hc]
  omega

theorem map_const_mul_x {dt dx : Int → Int} (hD : SpaceTimeDerivations dt dx)
    (c a : Int) (hc : dx c = 0) : dx (c * a) = c * dx a := by
  rw [hD.leibniz_x c a, hc]
  omega

end SpaceTimeDerivations

/-- First-order bulk Lagrangian jet data equipped with derivations `(dt, dx)` (Section 2.1, K = 1). -/
structure FirstOrderBulkJet (dt dx : Int → Int) where
  φ    : Int  -- Field `φ`
  L    : Int  -- Lagrangian density `L(φ, dt φ, dx φ)`
  L_φ  : Int  -- Partial derivative `∂L / ∂φ`
  L_φt : Int  -- Partial derivative `∂L / ∂(dt φ)`
  L_φx : Int  -- Partial derivative `∂L / ∂(dx φ)`
  chain_t : dt L = L_φ * dt φ + L_φt * dt (dt φ) + L_φx * dt (dx φ)
  chain_x : dx L = L_φ * dx φ + L_φt * dx (dt φ) + L_φx * dx (dx φ)

namespace FirstOrderBulkJet

variable {dt dx : Int → Int}

/-- Equation (2.5): The spatial canonical momentum `π_0^(x) = ∂L / ∂(dx φ)`. -/
def π_x (J : FirstOrderBulkJet dt dx) : Int := J.L_φx

/-- Equation (2.8): The Ostrogradsky spatial Hamiltonian density `H^(x) = π^(x) dx φ - L`. -/
def H_x (J : FirstOrderBulkJet dt dx) : Int := J.π_x * dx J.φ - J.L

/-- Canonical energy density `T^0_0 = (∂L/∂φ_t) dt φ - L`. -/
def T0_0 (J : FirstOrderBulkJet dt dx) : Int := J.L_φt * dt J.φ - J.L

/-- Canonical energy flux `T^1_0 = (∂L/∂φ_x) dt φ`. -/
def T1_0 (J : FirstOrderBulkJet dt dx) : Int := J.L_φx * dt J.φ

/-- Canonical momentum density `T^01 = -T^0_1 = -(∂L/∂φ_t) dx φ`. -/
def T01 (J : FirstOrderBulkJet dt dx) : Int := -(J.L_φt * dx J.φ)

/-- Canonical stress tensor spatial component `T^1_1 = (∂L/∂φ_x) dx φ - L`. -/
def T1_1 (J : FirstOrderBulkJet dt dx) : Int := J.L_φx * dx J.φ - J.L

/-- Canonical momentum flux `T^11 = -T^1_1 = L - (∂L/∂φ_x) dx φ`. -/
def T11 (J : FirstOrderBulkJet dt dx) : Int := -J.T1_1

/-- Bulk Euler–Lagrange derivative `E([φ]) = ∂L/∂φ - dt(∂L/∂φ_t) - dx(∂L/∂φ_x)`. -/
def eulerLagrange (J : FirstOrderBulkJet dt dx) : Int :=
  J.L_φ - dt J.L_φt - dx J.L_φx

/-- **Lemma 2.1 (First-Order Case, Equations 2.10 & 2.13):**
Using the Leibniz product rule (`hD.leibniz_t`, `hD.leibniz_x'`) and commutativity of
derivations (`hD.comm`), we derive:
1. `T^1_0 = π^(x) * dt φ`;
2. `T^1_1 = H^(x)` and `T^11 = -H^(x)`;
3. Off-shell Noether energy identity: `dt T^0_0 + dx T^1_0 = -E([φ]) * dt φ`;
4. Off-shell Noether momentum identity: `dt T^01 + dx T^11 = +E([φ]) * dx φ`
   (equivalently `dt (-T^01) + dx T^1_1 = -E([φ]) * dx φ`). -/
theorem lemma_2_1_first_order (hD : SpaceTimeDerivations dt dx)
    (J : FirstOrderBulkJet dt dx) :
    J.T1_0 = J.π_x * dt J.φ ∧
    J.T1_1 = J.H_x ∧
    J.T11 = -J.H_x ∧
    dt J.T0_0 + dx J.T1_0 = -J.eulerLagrange * dt J.φ ∧
    dt J.T01 + dx J.T11 = J.eulerLagrange * dx J.φ := by
  refine ⟨rfl, rfl, rfl, ?_, ?_⟩
  · dsimp [T0_0, T1_0, eulerLagrange]
    rw [hD.map_sub_t, hD.leibniz_t, hD.leibniz_x', J.chain_t, hD.comm J.φ]
    have hE : -(J.L_φ - dt J.L_φt - dx J.L_φx) = -J.L_φ + dt J.L_φt + dx J.L_φx := by omega
    rw [hE, Int.add_mul, Int.add_mul, Int.neg_mul]
    omega
  · dsimp [T01, T11, T1_1, eulerLagrange]
    rw [hD.map_neg_t, hD.leibniz_t, hD.map_neg_x, hD.map_sub_x, hD.leibniz_x',
        J.chain_x, hD.comm J.φ]
    rw [Int.sub_mul, Int.sub_mul]
    omega

end FirstOrderBulkJet

/-- **Equation (2.6) for `K = 2` (Second-Order Ostrogradsky Variational Identity):**
For any second-order spatial Lagrangian with partial Euler–Lagrange derivatives `F0, F1, F2`,
defining `π0_x := F1 - dx F2`, `π1_x := F2`, and `E_bulk := F0 - dx F1 + dx (dx F2)`,
the Leibniz product rule (`hD.leibniz_x'`) implies that the spatial variation decomposes
into `E_bulk * δφ` plus the exact spatial derivative `dx (π0_x * δφ + π1_x * dx δφ)`
plus the temporal divergence `dt Ξ`. -/
theorem ostrogradsky_K2_variational_identity
    (dt dx : Int → Int) (hD : SpaceTimeDerivations dt dx)
    (F0 F1 F2 δφ Ξ : Int) :
    let E_bulk := F0 - dx F1 + dx (dx F2)
    let π0_x   := F1 - dx F2
    let π1_x   := F2
    F0 * δφ + F1 * dx δφ + F2 * dx (dx δφ) + dt Ξ =
      E_bulk * δφ + dx (π0_x * δφ + π1_x * dx δφ) + dt Ξ := by
  intro E_bulk π0_x π1_x
  dsimp [E_bulk, π0_x, π1_x]
  rw [hD.map_add_x, hD.leibniz_x' (F1 - dx F2) δφ, hD.leibniz_x' F2 (dx δφ), hD.map_sub_x]
  rw [Int.sub_mul, Int.add_mul, Int.sub_mul, Int.sub_mul]
  omega

/-- **Lemma 2.1 (Higher-Order Ostrogradsky Case, Equations 2.8 & 2.13):**
Specializing the Ostrogradsky variational identity (2.6) to a spatial translation
`δφ = dx φ` (`dx L = F0 * dx φ + F1 * dx (dx φ) + F2 * dx (dx (dx φ)) + dt Ξ_x`) and
defining `H_x := π0_x * dx φ + π1_x * dx (dx φ) - L`, the Leibniz rule proves:
1. `dx H_x + dt Ξ_x = -E_bulk * dx φ`;
2. Comparing with Noether's spatial translation identity `dt (-T01) + dx T1_1 = -E_bulk * dx φ`
   when the temporal terms differ by `T1_1 - H_x = dt Υ1` (and `T11 = -T1_1`) gives
   `T11 = -H_x - dt Υ1`, and `H_x = -T11` whenever `dt Υ1 = 0`. -/
theorem lemma_2_1_ostrogradsky
    (dt dx : Int → Int) (hD : SpaceTimeDerivations dt dx)
    (L φ F0 F1 F2 Ξ_x T1_1 T11 Υ1 : Int)
    (h_dx_L : dx L = F0 * dx φ + F1 * dx (dx φ) + F2 * dx (dx (dx φ)) + dt Ξ_x)
    (h_T1_1 : T1_1 = ((F1 - dx F2) * dx φ + F2 * dx (dx φ) - L) + dt Υ1)
    (h_T11  : T11 = -T1_1) :
    let E_bulk := F0 - dx F1 + dx (dx F2)
    let π0_x   := F1 - dx F2
    let π1_x   := F2
    let H_x    := π0_x * dx φ + π1_x * dx (dx φ) - L
    dx H_x + dt Ξ_x = -E_bulk * dx φ ∧
    T11 = -H_x - dt Υ1 ∧
    (dt Υ1 = 0 → H_x = -T11) := by
  intro E_bulk π0_x π1_x H_x
  have h_var := ostrogradsky_K2_variational_identity dt dx hD F0 F1 F2 (dx φ) Ξ_x
  dsimp at h_var
  refine ⟨?_, ?_, ?_⟩
  · dsimp [H_x, π0_x, π1_x, E_bulk]
    rw [hD.map_sub_x, h_dx_L, h_var, Int.neg_mul]
    omega
  · dsimp [H_x, π0_x, π1_x] at *
    omega
  · intro h0
    dsimp [H_x, π0_x, π1_x] at *
    omega

/-!
## 2. Section 3: Defect Sewing Relations as Lagrangian Correspondences, Coisotropy, Schur Complement, Lemma 3.1 & Theorem 1
-/

/-- The difference symplectic form `(Ω_- ⊖ Ω_+)((u_-, u_+), (v_-, v_+)) = Ω_-(u_-, v_-) - Ω_+(u_+, v_+)`
on the product space `V_minus × V_plus`. -/
def omegaDiff {V_minus V_plus : Type}
    (Ω_minus : V_minus → V_minus → Int)
    (Ω_plus  : V_plus  → V_plus  → Int)
    (u v : V_minus × V_plus) : Int :=
  Ω_minus u.1 v.1 - Ω_plus u.2 v.2

/-- A subspace `Γ : (V_minus × V_plus) → Prop` is **Lagrangian** in the strong sense
(`Γ^⊥ = Γ`, both isotropic and coisotropic) with respect to `Ω_- ⊖ Ω_+` if
`w ∈ Γ ↔ ∀ v ∈ Γ, (Ω_- ⊖ Ω_+)(w, v) = 0`. -/
def IsLagrangianSubspace {V_minus V_plus : Type}
    (Ω_minus : V_minus → V_minus → Int)
    (Ω_plus  : V_plus  → V_plus  → Int)
    (Γ : V_minus × V_plus → Prop) : Prop :=
  ∀ w : V_minus × V_plus, (∀ v : V_minus × V_plus, Γ v → omegaDiff Ω_minus Ω_plus w v = 0) ↔ Γ w

/-- **Equation (3.6) & Coisotropy (`eq_3_6_generating_functional_lagrangian`):**
Let `U_minus` and `U_plus` be configuration spaces equipped with bilinear pairings
`pair_minus : U_minus → U_minus → Int` and `pair_plus : U_plus → U_plus → Int` and
canonical symplectic forms `Ω_±((q_1, p_1), (q_2, p_2)) = pair_± q_1 p_2 - pair_± q_2 p_1`.
Let `S_ΦΦ, S_ΨΨ, S_ΦΨ, S_ΨΦ` be linear second-variation operators of `S_d` that are
formally self-adjoint (`S_ΦΦ, S_ΨΨ` symmetric and `S_ΨΦ = S_ΦΨ^*`).
Then the linearized defect correspondence `TΓ_d` defined by
`δπ_- = -(S_ΦΦ δΦ + S_ΦΨ δΨ)` and `δπ_+ = S_ΨΦ δΦ + S_ΨΨ δΨ`
is **both isotropic and coisotropic**, i.e., `IsLagrangianSubspace Ω_minus Ω_plus TΓ_d` holds. -/
theorem eq_3_6_generating_functional_lagrangian
    {U_minus U_plus : Type}
    (zero_minus : U_minus) (zero_plus : U_plus)
    (add_minus : U_minus → U_minus → U_minus)
    (add_plus  : U_plus  → U_plus  → U_plus)
    (neg_minus : U_minus → U_minus)
    (pair_minus : U_minus → U_minus → Int)
    (pair_plus  : U_plus  → U_plus  → Int)
    (S_ΦΦ : U_minus → U_minus)
    (S_ΦΨ : U_plus  → U_minus)
    (S_ΨΦ : U_minus → U_plus)
    (S_ΨΨ : U_plus  → U_plus)
    -- Bilinearity and non-degeneracy of the pairings:
    (h_pair_m_zero_l : ∀ p : U_minus, pair_minus zero_minus p = 0)
    (h_pair_p_zero_l : ∀ p : U_plus,  pair_plus  zero_plus  p = 0)
    (h_pair_m_neg_r  : ∀ q p : U_minus, pair_minus q (neg_minus p) = -(pair_minus q p))
    (h_pair_m_add_r  : ∀ q p1 p2 : U_minus, pair_minus q (add_minus p1 p2) = pair_minus q p1 + pair_minus q p2)
    (h_pair_p_add_r  : ∀ q p1 p2 : U_plus,  pair_plus  q (add_plus  p1 p2) = pair_plus  q p1 + pair_plus  q p2)
    (h_nondeg_m : ∀ p1 p2 : U_minus, (∀ δΦ : U_minus, pair_minus δΦ p1 = pair_minus δΦ p2) → p1 = p2)
    (h_nondeg_p : ∀ p1 p2 : U_plus,  (∀ δΨ : U_plus,  pair_plus  δΨ p1 = pair_plus  δΨ p2) → p1 = p2)
    -- Formal self-adjointness of the second variations of S_d:
    (h_sym_ΦΦ  : ∀ u v : U_minus, pair_minus u (S_ΦΦ v) = pair_minus v (S_ΦΦ u))
    (h_sym_ΨΨ  : ∀ u v : U_plus,  pair_plus  u (S_ΨΨ v) = pair_plus  v (S_ΨΨ u))
    (h_adj_ΦΨ  : ∀ u : U_minus, ∀ v : U_plus, pair_minus u (S_ΦΨ v) = pair_plus v (S_ΨΦ u)) :
    let Ω_minus := fun (x y : U_minus × U_minus) => pair_minus x.1 y.2 - pair_minus y.1 x.2
    let Ω_plus  := fun (x y : U_plus  × U_plus)  => pair_plus  x.1 y.2 - pair_plus  y.1 x.2
    let TΓ_d    := fun (z : (U_minus × U_minus) × (U_plus × U_plus)) =>
      z.1.2 = neg_minus (add_minus (S_ΦΦ z.1.1) (S_ΦΨ z.2.1)) ∧
      z.2.2 = add_plus (S_ΨΦ z.1.1) (S_ΨΨ z.2.1)
    IsLagrangianSubspace Ω_minus Ω_plus TΓ_d := by
  intro Ω_minus Ω_plus TΓ_d w
  constructor
  · -- Coisotropy: (∀ v ∈ TΓ_d, (Ω_- ⊖ Ω_+)(w, v) = 0) → w ∈ TΓ_d
    intro hOrth
    dsimp [TΓ_d]
    constructor
    · -- Test with v = ((δΦ, -(S_ΦΦ δΦ + S_ΦΨ 0)), (0, S_ΨΦ δΦ + S_ΨΨ 0))
      apply h_nondeg_m
      intro δΦ
      let v : (U_minus × U_minus) × (U_plus × U_plus) :=
        ((δΦ, neg_minus (add_minus (S_ΦΦ δΦ) (S_ΦΨ zero_plus))),
         (zero_plus, add_plus (S_ΨΦ δΦ) (S_ΨΨ zero_plus)))
      have hv : TΓ_d v := ⟨rfl, rfl⟩
      have h0 := hOrth v hv
      dsimp [omegaDiff, Ω_minus, Ω_plus, v] at h0
      rw [h_pair_m_neg_r, h_pair_m_add_r, h_pair_p_zero_l, h_pair_p_add_r] at h0
      have h_SΦΨ_zero : pair_minus w.1.1 (S_ΦΨ zero_plus) = 0 := by
        rw [h_adj_ΦΨ w.1.1 zero_plus, h_pair_p_zero_l]
      have h_SΨΨ_zero : pair_plus w.2.1 (S_ΨΨ zero_plus) = 0 := by
        rw [h_sym_ΨΨ w.2.1 zero_plus, h_pair_p_zero_l]
      rw [h_SΦΨ_zero, h_SΨΨ_zero, h_sym_ΦΦ w.1.1 δΦ, ← h_adj_ΦΨ δΦ w.2.1] at h0
      have h_rhs :
          pair_minus δΦ (neg_minus (add_minus (S_ΦΦ w.1.1) (S_ΦΨ w.2.1))) =
          -(pair_minus δΦ (S_ΦΦ w.1.1) + pair_minus δΦ (S_ΦΨ w.2.1)) := by
        rw [h_pair_m_neg_r, h_pair_m_add_r]
      rw [h_rhs]
      omega
    · -- Test with v = ((0, -(S_ΦΦ 0 + S_ΦΨ δΨ)), (δΨ, S_ΨΦ 0 + S_ΨΨ δΨ))
      apply h_nondeg_p
      intro δΨ
      let v : (U_minus × U_minus) × (U_plus × U_plus) :=
        ((zero_minus, neg_minus (add_minus (S_ΦΦ zero_minus) (S_ΦΨ δΨ))),
         (δΨ, add_plus (S_ΨΦ zero_minus) (S_ΨΨ δΨ)))
      have hv : TΓ_d v := ⟨rfl, rfl⟩
      have h0 := hOrth v hv
      dsimp [omegaDiff, Ω_minus, Ω_plus, v] at h0
      rw [h_pair_m_neg_r, h_pair_m_add_r, h_pair_m_zero_l, h_pair_p_add_r] at h0
      have h_SΦΦ_zero : pair_minus w.1.1 (S_ΦΦ zero_minus) = 0 := by
        rw [h_sym_ΦΦ w.1.1 zero_minus, h_pair_m_zero_l]
      have h_SΨΦ_zero : pair_plus w.2.1 (S_ΨΦ zero_minus) = 0 := by
        rw [← h_adj_ΦΨ zero_minus w.2.1, h_pair_m_zero_l]
      rw [h_SΦΦ_zero, h_SΨΦ_zero, h_adj_ΦΨ w.1.1 δΨ, h_sym_ΨΨ w.2.1 δΨ] at h0
      have h_rhs :
          pair_plus δΨ (add_plus (S_ΨΦ w.1.1) (S_ΨΨ w.2.1)) =
          pair_plus δΨ (S_ΨΦ w.1.1) + pair_plus δΨ (S_ΨΨ w.2.1) := by
        rw [h_pair_p_add_r]
      rw [h_rhs]
      omega
  · -- Isotropy: w ∈ TΓ_d → ∀ v ∈ TΓ_d, (Ω_- ⊖ Ω_+)(w, v) = 0
    intro hw v hv
    rcases hw with ⟨hw1, hw2⟩
    rcases hv with ⟨hv1, hv2⟩
    dsimp [omegaDiff, Ω_minus, Ω_plus]
    rw [hw1, hw2, hv1, hv2]
    rw [h_pair_m_neg_r, h_pair_m_neg_r,
        h_pair_m_add_r, h_pair_m_add_r,
        h_pair_p_add_r, h_pair_p_add_r]
    rw [h_sym_ΦΦ w.1.1 v.1.1, h_sym_ΨΨ w.2.1 v.2.1,
        h_adj_ΦΨ w.1.1 v.2.1, h_adj_ΦΨ v.1.1 w.2.1]
    omega

/-- **Remark 3.1 (Equation 3.7): Automatic Conservation of Total Energy.**
For any time-translation-invariant defect action `S_d` where the autonomous time-Legendre
identity `dt Ed_0 = -(dSd_dΦ * dt Φ + dSd_dΨ * dt Ψ + dSd_dlam * dt lam)` holds on `dSd_dlam = 0`,
combining Lemma 2.1 (`T_±^1_0 = π_±^(x) * dt Φ_± + dt Υ_{0,±}`) with the boundary
Euler–Lagrange equations (3.4) derives `T_-^1_0 - T_+^1_0 = dt Ed` and
`dE_minus_dt + dE_plus_dt + dt Ed = 0`. -/
theorem remark_3_1_automatic_energy_conservation
    (dt : Int → Int) (h_add_t : ∀ a b : Int, dt (a + b) = dt a + dt b)
    (h_sub_t : ∀ a b : Int, dt (a - b) = dt a - dt b)
    (Φ_t Ψ_t lam_t π_minus π_plus dSd_dΦ dSd_dΨ dSd_dlam Ed_0 Υ0_minus Υ0_plus : Int)
    (T_minus_1_0 T_plus_1_0 dE_minus_dt dE_plus_dt : Int)
    (h_lem21_m : T_minus_1_0 = π_minus * Φ_t + dt Υ0_minus)
    (h_lem21_p : T_plus_1_0  = π_plus  * Ψ_t + dt Υ0_plus)
    (h_sew_m   : π_minus = -dSd_dΦ)
    (h_sew_p   : π_plus  = dSd_dΨ)
    (h_sew_lam : dSd_dlam = 0)
    (h_auton   : dt Ed_0 = -(dSd_dΦ * Φ_t + dSd_dΨ * Ψ_t + dSd_dlam * lam_t))
    (h_bulk    : dE_minus_dt + dE_plus_dt = -(T_minus_1_0 - T_plus_1_0)) :
    let Ed := Ed_0 + (Υ0_minus - Υ0_plus)
    T_minus_1_0 - T_plus_1_0 = dt Ed ∧
    dE_minus_dt + dE_plus_dt + dt Ed = 0 := by
  intro Ed
  dsimp [Ed]
  rw [h_add_t, h_sub_t, h_auton, h_sew_lam]
  have h1 : (-dSd_dΦ) * Φ_t = -(dSd_dΦ * Φ_t) := by rw [Int.neg_mul]
  rw [h_sew_m, h1] at h_lem21_m
  rw [h_sew_p] at h_lem21_p
  rw [h_lem21_m, h_lem21_p] at *
  omega

/-- `X` is a Hamiltonian vector for the differential `dH` with respect to `Ω` if
`ι_X Ω = dH`, i.e., `∀ v, Ω X v = dH v` (Equation 2.9). -/
def IsHamiltonianVector {V : Type} (Ω : V → V → Int) (dH : V → Int) (X : V) : Prop :=
  ∀ v : V, Ω X v = dH v

/-- **Equation (3.8):** For any Hamiltonian vectors `X_-` and `X_+`, pairing `(X_-, X_+)`
with any `v = (v_-, v_+)` under `Ω_- ⊖ Ω_+` produces `dH_-(v_-) - dH_+(v_+)`. -/
theorem eq_3_8_symplectic_pairing {V_minus V_plus : Type}
    (Ω_minus : V_minus → V_minus → Int)
    (Ω_plus  : V_plus  → V_plus  → Int)
    (dH_minus : V_minus → Int) (dH_plus : V_plus → Int)
    (X_minus : V_minus) (X_plus : V_plus)
    (hX_minus : IsHamiltonianVector Ω_minus dH_minus X_minus)
    (hX_plus  : IsHamiltonianVector Ω_plus  dH_plus  X_plus)
    (v : V_minus × V_plus) :
    omegaDiff Ω_minus Ω_plus (X_minus, X_plus) v = dH_minus v.1 - dH_plus v.2 := by
  dsimp [omegaDiff]
  rw [hX_minus v.1, hX_plus v.2]

/-- **Lemma 3.1 (Symplectic Intertwining on a Lagrangian Correspondence):**
Let `Γ ⊂ V_minus × V_plus` be a Lagrangian subspace (`Γ^⊥ = Γ`) with respect to `Ω_- ⊖ Ω_+`,
and let `X_-` and `X_+` be the Hamiltonian vectors of `dH_-` and `dH_+`. Then the
Hamilton–Jacobi condition (`dH_-(v_-) - dH_+(v_+) = 0` for all `(v_-, v_+) ∈ Γ`) holds
if and only if the pair of Hamiltonian vectors `(X_-, X_+)` lies in `Γ`. -/
theorem lemma_3_1_symplectic_intertwining {V_minus V_plus : Type}
    (Ω_minus : V_minus → V_minus → Int)
    (Ω_plus  : V_plus  → V_plus  → Int)
    (Γ : V_minus × V_plus → Prop)
    (hLag : IsLagrangianSubspace Ω_minus Ω_plus Γ)
    (dH_minus : V_minus → Int) (dH_plus : V_plus → Int)
    (X_minus : V_minus) (X_plus : V_plus)
    (hX_minus : IsHamiltonianVector Ω_minus dH_minus X_minus)
    (hX_plus  : IsHamiltonianVector Ω_plus  dH_plus  X_plus) :
    (∀ v : V_minus × V_plus, Γ v → dH_minus v.1 - dH_plus v.2 = 0) ↔ Γ (X_minus, X_plus) := by
  rw [← hLag (X_minus, X_plus)]
  constructor
  · intro hHJ v hv
    rw [eq_3_8_symplectic_pairing Ω_minus Ω_plus dH_minus dH_plus X_minus X_plus hX_minus hX_plus v]
    exact hHJ v hv
  · intro hOrth v hv
    rw [← eq_3_8_symplectic_pairing Ω_minus Ω_plus dH_minus dH_plus X_minus X_plus hX_minus hX_plus v]
    exact hOrth v hv

/-- A linear correspondence `Γ ⊂ V_minus × V_plus` is closed under subtraction and
transverse to the vertical fibers `{0} × V_plus` and `V_minus × {0}`. -/
structure TransverseLinearCorrespondence {V_minus V_plus : Type}
    (zero_minus : V_minus) (zero_plus : V_plus)
    (sub_minus : V_minus → V_minus → V_minus)
    (sub_plus  : V_plus  → V_plus  → V_plus)
    (Γ : V_minus × V_plus → Prop) : Prop where
  sub_mem : ∀ u v : V_minus × V_plus, Γ u → Γ v →
    Γ (sub_minus u.1 v.1, sub_plus u.2 v.2)
  sub_self_minus : ∀ x : V_minus, sub_minus x x = zero_minus
  sub_self_plus  : ∀ y : V_plus,  sub_plus y y = zero_plus
  eq_of_sub_eq_zero_minus : ∀ x y : V_minus, sub_minus x y = zero_minus → x = y
  eq_of_sub_eq_zero_plus  : ∀ x y : V_plus,  sub_plus x y = zero_plus → x = y
  transverse_right : ∀ w_plus : V_plus, Γ (zero_minus, w_plus) → w_plus = zero_plus
  transverse_left  : ∀ w_minus : V_minus, Γ (w_minus, zero_plus) → w_minus = zero_minus

/-- **Schur-Complement Transversality (`schur_complement_transversality`):**
For a general Type-I or Type-II defect with auxiliary variable `δλ : U_aux` satisfying
the linearized Euler–Lagrange system
`δπ_- = -(S_ΦΦ δΦ + S_ΦΨ δΨ + S_Φλ δλ)`,
`δπ_+ = S_ΨΦ δΦ + S_ΨΨ δΨ + S_Ψλ δλ`, and
`δλ = -(S_λλ⁻¹ (S_λΦ δΦ + S_λΨ δΨ))`,
eliminating `δλ` gives the reduced mixed Hessian operators (Schur complements)
`S_tilde_ΦΨ δΨ = S_ΦΨ δΨ - S_Φλ (S_λλ⁻¹ (S_λΨ δΨ))` and
`S_tilde_ΨΦ δΦ = S_ΨΦ δΦ - S_Ψλ (S_λλ⁻¹ (S_λΦ δΦ))`.
Whenever `S_tilde_ΦΨ` and `S_tilde_ΨΦ` have left inverses `S_tilde_ΦΨ_inv` and
`S_tilde_ΨΦ_inv` on the arbitrary configuration spaces `U_minus, U_plus`, the
correspondence `TΓ_d` satisfies **both `transverse_right` and `transverse_left`**. -/
theorem schur_complement_transversality
    {U_minus U_plus : Type}
    (zero_m : U_minus) (zero_p : U_plus)
    (neg_m : U_minus → U_minus)
    (add_m : U_minus → U_minus → U_minus)
    (add_p : U_plus  → U_plus  → U_plus)
    (S_tilde_ΦΦ : U_minus → U_minus)
    (S_tilde_ΦΨ : U_plus  → U_minus)
    (S_tilde_ΨΦ : U_minus → U_plus)
    (S_tilde_ΨΨ : U_plus  → U_plus)
    (S_tilde_ΦΨ_inv : U_minus → U_plus)
    (S_tilde_ΨΦ_inv : U_plus  → U_minus)
    (h_neg_m_zero   : neg_m zero_m = zero_m)
    (h_neg_m_inj    : ∀ a : U_minus, neg_m a = zero_m → a = zero_m)
    (h_add_m_zero_l : ∀ a : U_minus, add_m zero_m a = a)
    (h_add_m_zero_r : ∀ a : U_minus, add_m a zero_m = a)
    (h_add_p_zero_l : ∀ a : U_plus,  add_p zero_p a = a)
    (h_add_p_zero_r : ∀ a : U_plus,  add_p a zero_p = a)
    (h_SΦΦ_zero     : S_tilde_ΦΦ zero_m = zero_m)
    (h_SΦΨ_zero     : S_tilde_ΦΨ zero_p = zero_m)
    (h_SΨΦ_zero     : S_tilde_ΨΦ zero_m = zero_p)
    (h_SΨΨ_zero     : S_tilde_ΨΨ zero_p = zero_p)
    (h_inv_ΦΨ_zero  : S_tilde_ΦΨ_inv zero_m = zero_p)
    (h_inv_ΨΦ_zero  : S_tilde_ΨΦ_inv zero_p = zero_m)
    (h_left_inv_ΦΨ  : ∀ δΨ : U_plus,  S_tilde_ΦΨ_inv (S_tilde_ΦΨ δΨ) = δΨ)
    (h_left_inv_ΨΦ  : ∀ δΦ : U_minus, S_tilde_ΨΦ_inv (S_tilde_ΨΦ δΦ) = δΦ) :
    let TΓ_d := fun (z : (U_minus × U_minus) × (U_plus × U_plus)) =>
      z.1.2 = neg_m (add_m (S_tilde_ΦΦ z.1.1) (S_tilde_ΦΨ z.2.1)) ∧
      z.2.2 = add_p (S_tilde_ΨΦ z.1.1) (S_tilde_ΨΨ z.2.1)
    (∀ w_plus : U_plus × U_plus, TΓ_d ((zero_m, zero_m), w_plus) → w_plus = (zero_p, zero_p)) ∧
    (∀ w_minus : U_minus × U_minus, TΓ_d (w_minus, (zero_p, zero_p)) → w_minus = (zero_m, zero_m)) := by
  intro TΓ_d
  constructor
  · -- transverse_right: ((0, 0), (δΨ, δπ_+)) ∈ TΓ_d → (δΨ, δπ_+) = (0, 0)
    intro ⟨δΨ, δπ_plus⟩ ⟨h1, h2⟩
    dsimp at h1 h2
    rw [h_SΦΦ_zero, h_add_m_zero_l] at h1
    have h_SΦΨ_eq : S_tilde_ΦΨ δΨ = zero_m := h_neg_m_inj (S_tilde_ΦΨ δΨ) h1.symm
    have h_δΨ : δΨ = zero_p := by
      rw [← h_left_inv_ΦΨ δΨ, h_SΦΨ_eq, h_inv_ΦΨ_zero]
    subst h_δΨ
    rw [h_SΨΦ_zero, h_SΨΨ_zero, h_add_p_zero_l] at h2
    subst h2
    rfl
  · -- transverse_left: ((δΦ, δπ_-), (0, 0)) ∈ TΓ_d → (δΦ, δπ_-) = (0, 0)
    intro ⟨δΦ, δπ_minus⟩ ⟨h1, h2⟩
    dsimp at h1 h2
    rw [h_SΨΨ_zero, h_add_p_zero_r] at h2
    have h_δΦ : δΦ = zero_m := by
      rw [← h_left_inv_ΨΦ δΦ, ← h2, h_inv_ΨΦ_zero]
    subst h_δΦ
    rw [h_SΦΦ_zero, h_SΦΨ_zero, h_add_m_zero_l, h_neg_m_zero] at h1
    subst h1
    rfl

/-- **Theorem 1 (Connected Spatial Hamilton–Jacobi and Bäcklund Equivalence):**
Let `TΓ_d ⊂ V_minus × V_plus` be a Lagrangian (`TΓ_d^⊥ = TΓ_d`) and transverse linear
correspondence, let `dt` be the time derivation and `int_t` the time-integration functional
(annihilating `dt`-derivatives: `∀ f, int_t (dt f) = 0`), such that the linearized
spatial Hamiltonians are the time integrals of the linearized Hamiltonian densities
(`dH_± v = int_t (dH_x_± v)`), where `dT11_± v = -dH_x_± v - dt (dΥ1_± v)` by Lemma 2.1.
Then all steps of Theorem 1 are connected in a single chain:
1. **(1) ↔ (2a) (Local Momentum Balance ↔ Local Spatial Hamilton–Jacobi Equation):**
   For every `v ∈ TΓ_d`, `-dT11_minus v.1 + dT11_plus v.2 + dt (dPd v) = 0` holds if and
   only if `dH_x_minus v.1 - dH_x_plus v.2 = -dt (dPd v + dΥ1_minus v.1 - dΥ1_plus v.2)`;
2. **(1) → (2b) (Local Momentum Balance → Integrated Differential Hamilton–Jacobi):**
   If `-dT11_minus v.1 + dT11_plus v.2 + dt (dPd v) = 0` holds for all `v ∈ TΓ_d`, then
   `dH_minus v.1 - dH_plus v.2 = 0` holds for all `v ∈ TΓ_d`;
3. **(2b) ↔ (3a) (Differential Hamilton–Jacobi ↔ Symplectic Tangency):**
   `(∀ v ∈ TΓ_d, dH_minus v.1 - dH_plus v.2 = 0) ↔ TΓ_d (X_minus, X_plus)`;
4. **(1) → (3b) (Local Momentum Balance → Spatial Bäcklund Intertwining of Bulk PDEs):**
   If the local momentum balance holds on `TΓ_d`, then `(X_minus, X_plus) ∈ TΓ_d` and for
   every trajectory `(dx_z_minus, dx_z_plus) ∈ TΓ_d`,
   `dx_z_minus = X_minus ↔ dx_z_plus = X_plus`. -/
theorem theorem_1_spatial_hamilton_jacobi_and_backlund
    {V_minus V_plus : Type}
    (Ω_minus : V_minus → V_minus → Int)
    (Ω_plus  : V_plus  → V_plus  → Int)
    (TΓ_d : V_minus × V_plus → Prop)
    (hLag : IsLagrangianSubspace Ω_minus Ω_plus TΓ_d)
    (zero_minus : V_minus) (zero_plus : V_plus)
    (sub_minus : V_minus → V_minus → V_minus)
    (sub_plus  : V_plus  → V_plus  → V_plus)
    (hTrans : TransverseLinearCorrespondence zero_minus zero_plus sub_minus sub_plus TΓ_d)
    -- Time derivation and time integral (annihilating total time derivatives):
    (dt int_t : Int → Int)
    (h_dt_add  : ∀ a b : Int, dt (a + b) = dt a + dt b)
    (h_dt_sub  : ∀ a b : Int, dt (a - b) = dt a - dt b)
    (h_int_sub : ∀ a b : Int, int_t (a - b) = int_t a - int_t b)
    (h_int_dt  : ∀ f : Int, int_t (dt f) = 0)
    -- Linearized spatial Hamiltonian densities, momentum fluxes, and integrated differentials:
    (dH_x_minus dT11_minus dΥ1_minus : V_minus → Int)
    (dH_x_plus  dT11_plus  dΥ1_plus  : V_plus  → Int)
    (dPd : V_minus × V_plus → Int)
    (dH_minus : V_minus → Int) (dH_plus : V_plus → Int)
    (h_lem21_m : ∀ u : V_minus, dT11_minus u = -dH_x_minus u - dt (dΥ1_minus u))
    (h_lem21_p : ∀ w : V_plus,  dT11_plus  w = -dH_x_plus  w - dt (dΥ1_plus  w))
    (h_int_Hm  : ∀ u : V_minus, dH_minus u = int_t (dH_x_minus u))
    (h_int_Hp  : ∀ w : V_plus,  dH_plus  w = int_t (dH_x_plus  w))
    -- Hamiltonian vector fields and spatial trajectory:
    (X_minus : V_minus) (X_plus : V_plus)
    (hX_minus : IsHamiltonianVector Ω_minus dH_minus X_minus)
    (hX_plus  : IsHamiltonianVector Ω_plus  dH_plus  X_plus)
    (dx_z_minus : V_minus) (dx_z_plus : V_plus)
    (h_traj : TΓ_d (dx_z_minus, dx_z_plus)) :
    let dPtilde := fun v : V_minus × V_plus => dPd v + dΥ1_minus v.1 - dΥ1_plus v.2
    -- 1. Equivalence (1) ↔ (2a) at the density level:
    (∀ v : V_minus × V_plus,
      (-dT11_minus v.1 + dT11_plus v.2 + dt (dPd v) = 0) ↔
      (dH_x_minus v.1 - dH_x_plus v.2 = -dt (dPtilde v))) ∧
    -- 2. Implication (1) → (2b) from density balance to integrated differential HJ:
    ((∀ v : V_minus × V_plus, TΓ_d v → -dT11_minus v.1 + dT11_plus v.2 + dt (dPd v) = 0) →
      (∀ v : V_minus × V_plus, TΓ_d v → dH_minus v.1 - dH_plus v.2 = 0)) ∧
    -- 3. Equivalence (2b) ↔ (3a) between differential HJ and symplectic tangency:
    ((∀ v : V_minus × V_plus, TΓ_d v → dH_minus v.1 - dH_plus v.2 = 0) ↔
      TΓ_d (X_minus, X_plus)) ∧
    -- 4. Connected chain (1) → (3b): local momentum balance implies Bäcklund PDE equivalence:
    ((∀ v : V_minus × V_plus, TΓ_d v → -dT11_minus v.1 + dT11_plus v.2 + dt (dPd v) = 0) →
      TΓ_d (X_minus, X_plus) ∧ (dx_z_minus = X_minus ↔ dx_z_plus = X_plus)) := by
  intro dPtilde
  have h_dens_equiv : ∀ v : V_minus × V_plus,
      (-dT11_minus v.1 + dT11_plus v.2 + dt (dPd v) = 0) ↔
      (dH_x_minus v.1 - dH_x_plus v.2 = -dt (dPtilde v)) := by
    intro v
    dsimp [dPtilde]
    rw [h_lem21_m v.1, h_lem21_p v.2, h_dt_sub, h_dt_add]
    omega
  have h_int_imp :
      (∀ v : V_minus × V_plus, TΓ_d v → -dT11_minus v.1 + dT11_plus v.2 + dt (dPd v) = 0) →
      (∀ v : V_minus × V_plus, TΓ_d v → dH_minus v.1 - dH_plus v.2 = 0) := by
    intro hBal v hv
    have h_hj_dens : dH_x_minus v.1 - dH_x_plus v.2 = -dt (dPtilde v) :=
      (h_dens_equiv v).mp (hBal v hv)
    have h_dt_zero : dt 0 = 0 := by
      have h0 := h_dt_sub 0 0
      have hz : (0 : Int) - 0 = 0 := rfl
      rw [hz] at h0
      omega
    have h_dt_diff : dH_x_minus v.1 - dH_x_plus v.2 = dt (0 - dPtilde v) := by
      rw [h_dt_sub, h_dt_zero]
      omega
    rw [h_int_Hm v.1, h_int_Hp v.2, ← h_int_sub, h_dt_diff, h_int_dt]
  have h_intertwine :=
    lemma_3_1_symplectic_intertwining Ω_minus Ω_plus TΓ_d hLag dH_minus dH_plus
      X_minus X_plus hX_minus hX_plus
  refine ⟨h_dens_equiv, h_int_imp, h_intertwine, ?_⟩
  intro hBal
  have hTang : TΓ_d (X_minus, X_plus) := h_intertwine.mp (h_int_imp hBal)
  have hDiff : TΓ_d (sub_minus dx_z_minus X_minus, sub_plus dx_z_plus X_plus) :=
    hTrans.sub_mem (dx_z_minus, dx_z_plus) (X_minus, X_plus) h_traj hTang
  refine ⟨hTang, ?_⟩
  constructor
  · intro hLeft
    rw [hLeft, hTrans.sub_self_minus X_minus] at hDiff
    exact hTrans.eq_of_sub_eq_zero_plus dx_z_plus X_plus
      (hTrans.transverse_right (sub_plus dx_z_plus X_plus) hDiff)
  · intro hRight
    rw [hRight, hTrans.sub_self_plus X_plus] at hDiff
    exact hTrans.eq_of_sub_eq_zero_minus dx_z_minus X_minus
      (hTrans.transverse_left (sub_minus dx_z_minus X_minus) hDiff)

/-!
## 3. Section 4.2: Proposition 4.1 — Universal Stress-Tensor Potential Identities
-/

/-- **Proposition 4.1 (Universal Stress-Tensor Potential Identities, Equations 4.1 & 4.2):**
On the algebra of vacuum-normalized local densities evaluated on histories decaying to
`0` as `|t| → ∞` (where `dt` is injective: `dt f = 0 → f = 0`):
1. Differentiating the temporal balances `dt E_d = T_-^1_0 - T_+^1_0` and
   `dt P_d = T_-^11 - T_+^11` with respect to `dx` and using `dt (dx a) = dx (dt a)`
   together with the bulk conservation laws proves `dt (dx E_d + T_-^0_0 - T_+^0_0) = 0`
   and `dt (dx P_d + T_-^01 - T_+^01) = 0`;
2. Injectivity of `dt` on vacuum-decaying histories gives `dx E_d = -(T_-^0_0 - T_+^0_0)`
   and `dx P_d = -(T_-^01 - T_+^01)`;
3. Whenever `dt Q_d = J_{N,-} - J_{N,+}` with `J_{N,±} = c * T_±^01`, the defect densities
   satisfy the exact continuity equation `dt Q_d + c * dx P_d = 0` (Equation 4.2). -/
theorem proposition_4_1_stress_tensor_potentials
    (dt dx : Int → Int)
    (hD : SpaceTimeDerivations dt dx)
    (h_vac_norm : ∀ f : Int, dt f = 0 → f = 0)
    (Ed Pd Qd c : Int)
    (T_minus_0_0 T_plus_0_0 T_minus_1_0 T_plus_1_0 : Int)
    (T_minus_01  T_plus_01  T_minus_11  T_plus_11  : Int)
    (JN_minus JN_plus : Int)
    (h_bulk_E_minus : dt T_minus_0_0 + dx T_minus_1_0 = 0)
    (h_bulk_E_plus  : dt T_plus_0_0  + dx T_plus_1_0  = 0)
    (h_bulk_P_minus : dt T_minus_01  + dx T_minus_11  = 0)
    (h_bulk_P_plus  : dt T_plus_01   + dx T_plus_11   = 0)
    (h_dt_Ed : dt Ed = T_minus_1_0 - T_plus_1_0)
    (h_dt_Pd : dt Pd = T_minus_11  - T_plus_11)
    (h_dt_Qd : dt Qd = JN_minus - JN_plus)
    (h_JN_minus : JN_minus = c * T_minus_01)
    (h_JN_plus  : JN_plus  = c * T_plus_01) :
    dt (dx Ed + (T_minus_0_0 - T_plus_0_0)) = 0 ∧
    dt (dx Pd + (T_minus_01  - T_plus_01))  = 0 ∧
    dx Ed = -(T_minus_0_0 - T_plus_0_0) ∧
    dx Pd = -(T_minus_01  - T_plus_01)  ∧
    dt Qd + c * dx Pd = 0 := by
  have hE_inv : dt (dx Ed + (T_minus_0_0 - T_plus_0_0)) = 0 := by
    rw [hD.map_add_t, hD.map_sub_t, hD.comm Ed, h_dt_Ed, hD.map_sub_x]
    omega
  have hP_inv : dt (dx Pd + (T_minus_01 - T_plus_01)) = 0 := by
    rw [hD.map_add_t, hD.map_sub_t, hD.comm Pd, h_dt_Pd, hD.map_sub_x]
    omega
  have h_dx_Ed_zero : dx Ed + (T_minus_0_0 - T_plus_0_0) = 0 :=
    h_vac_norm (dx Ed + (T_minus_0_0 - T_plus_0_0)) hE_inv
  have h_dx_Pd_zero : dx Pd + (T_minus_01 - T_plus_01) = 0 :=
    h_vac_norm (dx Pd + (T_minus_01 - T_plus_01)) hP_inv
  have h_dx_Ed : dx Ed = -(T_minus_0_0 - T_plus_0_0) := by omega
  have h_dx_Pd : dx Pd = -(T_minus_01 - T_plus_01) := by omega
  refine ⟨hE_inv, hP_inv, h_dx_Ed, h_dx_Pd, ?_⟩
  rw [h_dt_Qd, h_JN_minus, h_JN_plus, h_dx_Pd]
  have h_distrib : c * -(T_minus_01 - T_plus_01) = -(c * T_minus_01 - c * T_plus_01) := by
    rw [Int.mul_neg, Int.mul_sub]
  omega

/-!
## 4. Section 4.3: Theorem 2 — Gyroscopic Euler–Lagrange Equations (4.7), Jet Recursion (4.10), Compatibility, Principal Symbol (4.11), Taylor Expansion (4.12), and Involution (4.13)
-/

/-- **Equation (4.7): Derivation of Both Boundary Sewing Equations from `L_d = A_φ dt φ + A_ψ dt ψ - B`.**
Using the chain rule `dt A_φ = dA_φ_dφ * dt φ + dA_φ_dψ * dt ψ` and
`dt A_ψ = dA_ψ_dφ * dt φ + dA_ψ_dψ * dt ψ`, the Euler–Lagrange derivatives
`δS_d/δφ = ∂L_d/∂φ - dt (∂L_d/∂(dt φ))` and `δS_d/δψ = ∂L_d/∂ψ - dt (∂L_d/∂(dt ψ))`
yield (with `Ω_{AB} := ∂_A A_B - ∂_B A_A`):
1. `π_-^(x) = -δS_d/δφ = -Ω_φφ dt φ - Ω_φψ dt ψ + ∇_φ B` (with `-` on the gyroscopic terms);
2. `π_+^(x) = +δS_d/δψ = +Ω_ψφ dt φ + Ω_ψψ dt ψ - ∇_ψ B` (with `+` on the gyroscopic terms). -/
theorem eq_4_7_gyroscopic_euler_lagrange
    (dt : Int → Int)
    (A_φ A_ψ φ ψ dA_φ_dφ dA_φ_dψ dA_ψ_dφ dA_ψ_dψ B_φ B_ψ : Int)
    (h_chain_Aφ : dt A_φ = dA_φ_dφ * dt φ + dA_φ_dψ * dt ψ)
    (h_chain_Aψ : dt A_ψ = dA_ψ_dφ * dt φ + dA_ψ_dψ * dt ψ) :
    let dLd_dφ   := dA_φ_dφ * dt φ + dA_ψ_dφ * dt ψ - B_φ
    let dLd_dψ   := dA_φ_dψ * dt φ + dA_ψ_dψ * dt ψ - B_ψ
    let dSd_dφ   := dLd_dφ - dt A_φ
    let dSd_dψ   := dLd_dψ - dt A_ψ
    let Ω_φφ     := dA_φ_dφ - dA_φ_dφ
    let Ω_φψ     := dA_ψ_dφ - dA_φ_dψ
    let Ω_ψφ     := dA_φ_dψ - dA_ψ_dφ
    let Ω_ψψ     := dA_ψ_dψ - dA_ψ_dψ
    let π_minus  := -dSd_dφ
    let π_plus   :=  dSd_dψ
    π_minus = -Ω_φφ * dt φ - Ω_φψ * dt ψ + B_φ ∧
    π_plus  =  Ω_ψφ * dt φ + Ω_ψψ * dt ψ - B_ψ := by
  intro dLd_dφ dLd_dψ dSd_dφ dSd_dψ Ω_φφ Ω_φψ Ω_ψφ Ω_ψψ π_minus π_plus
  dsimp [π_minus, π_plus, dSd_dφ, dSd_dψ, dLd_dφ, dLd_dψ, Ω_φφ, Ω_φψ, Ω_ψφ, Ω_ψψ]
  rw [h_chain_Aφ, h_chain_Aψ]
  have h1 : (dA_ψ_dφ - dA_φ_dψ) * dt ψ = dA_ψ_dφ * dt ψ - dA_φ_dψ * dt ψ := by
    rw [Int.sub_mul]
  have h2 : (dA_φ_dψ - dA_ψ_dφ) * dt φ = dA_φ_dψ * dt φ - dA_ψ_dφ * dt φ := by
    rw [Int.sub_mul]
  have h3 : -(dA_φ_dφ - dA_φ_dφ) * dt φ = 0 := by omega
  have h4 : (dA_ψ_dψ - dA_ψ_dψ) * dt ψ = 0 := by omega
  rw [h1, h2, h3, h4]
  omega

/-- **Theorem 2, Part 1a (Triangular Algebraic Jet Recursion, Equation 4.10):**
Given an invertible leading mixed Hessian operator `H` with inverse `H_inv`
(`∀ v, H_inv (H v) = v` and `∀ v, H (H_inv v) = v`), the `O(ε^0)` and `O(ε^n)`
sewing equations uniquely determine `Ψ_1` and `Ψ_{n+1}` via Equation (4.10). -/
theorem theorem_2_part_1_jet_recursion {Jet : Type}
    (H H_inv : Jet → Jet)
    (h_left_inv  : ∀ v : Jet, H_inv (H v) = v)
    (h_right_inv : ∀ v : Jet, H (H_inv v) = v)
    (Ψ1 rhs1 Ψ_next rhs_next : Jet) :
    (H Ψ1 = rhs1 ↔ Ψ1 = H_inv rhs1) ∧
    (H Ψ_next = rhs_next ↔ Ψ_next = H_inv rhs_next) := by
  refine ⟨⟨fun h => by rw [← h, h_left_inv], fun h => by rw [h, h_right_inv]⟩,
          ⟨fun h => by rw [← h, h_left_inv], fun h => by rw [h, h_right_inv]⟩⟩

/-- **Theorem 2, Step 1 (Compatibility of the Second Sewing Equation of 4.7 on Bulk Solutions):**
Suppose `ψ_eps` solves the first sewing equation of (4.7), and define `Pi_plus_eps := +δS_d/δψ`
to be the right-hand side of the second sewing equation of (4.7), so that the point
`((φ, π_minus_φ), (ψ_eps, Pi_plus_eps))` lies on the defect correspondence `Γ_d` at every `x`.
By Theorem 1(3), when `φ` solves the left bulk Hamilton equations `dx_z_minus = X_minus`,
`(ψ_eps, Pi_plus_eps)` solves the right bulk Hamilton equations `(dx_ψ_eps, dx_Pi_plus_eps) = X_plus`.
Since the configuration component of `X_plus` is the inverse spatial Legendre transform of the
canonical momentum (`legendre_plus ψ_eps dx_ψ_eps = π_plus_ψ_eps` and
`legendre_plus ψ_eps (X_plus_config ψ_eps Pi_plus_eps) = Pi_plus_eps`), it follows that
`Pi_plus_eps = π_plus_ψ_eps`, which is the second sewing equation of (4.7). -/
theorem theorem_2_second_sewing_compatibility
    {Config Mom : Type}
    (Γ_d_tan : (Config × Mom) × (Config × Mom) → Prop)
    (X_minus : Config × Mom)
    (X_plus_config : Config → Mom → Config)
    (X_plus_mom    : Config → Mom → Mom)
    (legendre_plus : Config → Config → Mom)
    (dx_φ ψ_eps dx_ψ_eps : Config)
    (dx_π_minus_φ Pi_plus_eps dx_Pi_plus_eps : Mom)
    -- Theorem 1(3b) Bäcklund intertwining property on Γ_d:
    (h_thm1_backlund :
      Γ_d_tan ((dx_φ, dx_π_minus_φ), (dx_ψ_eps, dx_Pi_plus_eps)) →
      ((dx_φ, dx_π_minus_φ) = X_minus ↔
        (dx_ψ_eps, dx_Pi_plus_eps) = (X_plus_config ψ_eps Pi_plus_eps, X_plus_mom ψ_eps Pi_plus_eps)))
    -- Spatial trajectory induced by solving the first sewing equation lies in Γ_d:
    (h_traj : Γ_d_tan ((dx_φ, dx_π_minus_φ), (dx_ψ_eps, dx_Pi_plus_eps)))
    -- Left field φ is a solution of the left bulk equation:
    (h_left_bulk : (dx_φ, dx_π_minus_φ) = X_minus)
    -- Invertibility of the right spatial Legendre transform (Equation 2.9 first Hamilton eq.):
    (h_legendre_inv : ∀ q : Config, ∀ p : Mom, legendre_plus q (X_plus_config q p) = p) :
    let π_plus_ψ_eps := legendre_plus ψ_eps dx_ψ_eps
    Pi_plus_eps = π_plus_ψ_eps := by
  intro π_plus_ψ_eps
  have h_right_bulk := (h_thm1_backlund h_traj).mp h_left_bulk
  have h_dx_ψ : dx_ψ_eps = X_plus_config ψ_eps Pi_plus_eps :=
    congrArg Prod.fst h_right_bulk
  dsimp [π_plus_ψ_eps]
  rw [h_dx_ψ, h_legendre_inv ψ_eps Pi_plus_eps]

/-- Iteration `R^[k]` of the principal-symbol operator `R = -H⁻¹ D ∂_t` (Equation 4.11). -/
def iterateOp {Sym : Type} (R : Sym → Sym) : Nat → Sym → Sym
  | 0,     v => v
  | k + 1, v => R (iterateOp R k v)

/-- **Theorem 2, Part 1b (Derivation of the Principal Symbol Formula 4.11 from Recursion 4.10):**
Suppose the sequence of jets `Ψ : Nat → Jet` satisfies the full inhomogeneous recursion (4.10):
`Ψ (k + 1) = H_inv (add_jet (neg_D_dt (Ψ k)) (rem k))`, where `rem k` has lower `∂_t`-order
than `neg_D_dt (Ψ k)`. Let `sym : Nat → Jet → Sym` extract the highest-order `∂_t`-symbol at
each step `k`, so that `sym (k + 1)` annihilates the lower-order remainder `rem k` and
intertwines `H_inv ∘ neg_D_dt` with `R_sym : Sym → Sym`. Then by induction on `k`,
`sym k (Ψ k) = iterateOp R_sym k (sym 0 (Ψ 0))`. -/
theorem theorem_2_part_1_principal_symbol {Jet Sym : Type}
    (H_inv neg_D_dt : Jet → Jet)
    (add_jet : Jet → Jet → Jet)
    (Ψ rem : Nat → Jet)
    (sym : Nat → Jet → Sym)
    (R_sym : Sym → Sym)
    -- Inhomogeneous recursion (4.10):
    (h_rec_4_10 : ∀ k : Nat, Ψ (k + 1) = H_inv (add_jet (neg_D_dt (Ψ k)) (rem k)))
    -- Symbol extraction properties (annihilating lower-order remainder `rem k`):
    (h_sym_step : ∀ k : Nat, ∀ u : Jet,
      sym (k + 1) (H_inv (add_jet (neg_D_dt u) (rem k))) = R_sym (sym k u)) :
    ∀ k : Nat, sym k (Ψ k) = iterateOp R_sym k (sym 0 (Ψ 0)) := by
  intro k
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [h_rec_4_10 k, h_sym_step k (Ψ k), ih]
    rfl

/-- **Non-vanishing of the Principal Symbol (`principal_symbol_nonzero`):**
If `R_sym = -H⁻¹ D ∂_t` is injective on vacuum-decaying highest-jet symbols
(`R_sym v = zero → v = zero`) and `sym 0 (Ψ 0) ≠ zero`, then `sym k (Ψ k) ≠ zero` for all `k`. -/
theorem principal_symbol_nonzero {Sym : Type}
    (zero : Sym) (R_sym : Sym → Sym)
    (hR_inj : ∀ v : Sym, R_sym v = zero → v = zero)
    (v0 : Sym) (hv0 : v0 ≠ zero) :
    ∀ k : Nat, iterateOp R_sym k v0 ≠ zero := by
  intro k
  induction k with
  | zero => exact hv0
  | succ k ih =>
    intro h_eq
    apply ih
    exact hR_inj (iterateOp R_sym k v0) h_eq

/-- Formal power series `∑_{n=0}^∞ ε^n a_n` represented by its coefficient sequence `Nat → Int`. -/
abbrev FormalSeries := Nat → Int

/-- Termwise application of a derivation `D` to a formal power series. -/
def mapSeries (D : Int → Int) (S : FormalSeries) : FormalSeries :=
  fun n => D (S n)

/-- Addition of two formal power series. -/
def addSeries (S1 S2 : FormalSeries) : FormalSeries :=
  fun n => S1 n + S2 n

/-- The zero formal power series. -/
def zeroSeries : FormalSeries := fun _ => 0

/-- **Theorem 2, Part 2a (Infinite Sequence of Local Conservation Laws, Equation 4.6):**
If the formal power series `Q(ε) = ∑_{n=0}^∞ ε^n Q_n` and `J(ε) = ∑_{n=0}^∞ ε^n J_n`
satisfy the defect continuity equation `dt Q(ε) + dx J(ε) = 0` as formal power series,
then for every `n : Nat`, `dt (Q n) + dx (J n) = 0`. -/
theorem theorem_2_part_2_hierarchy_conservation_laws
    (dt dx : Int → Int)
    (Q J : FormalSeries)
    (h_continuity : addSeries (mapSeries dt Q) (mapSeries dx J) = zeroSeries) :
    ∀ n : Nat, dt (Q n) + dx (J n) = 0 := by
  intro n
  exact congrFun h_continuity n

/-- Quadratic Taylor expansion (scaled by 2) of a potential `f(φ, φ + δ)` in `δ = ψ - φ`:
`quadTaylor f0 df d2f δ = 2 f(φ,φ) + 2 ∂_ψ f(φ,φ) δ + ∂_ψ^2 f(φ,φ) δ^2`. -/
def quadTaylor (f0 df d2f δ : Int) : Int :=
  2 * f0 + 2 * df * δ + d2f * (δ * δ)

/-- **Theorem 2, Part 2b (Exact Taylor Expansion of `E_d(ε)` and First Conserved Density `Q_1`,
Equations 4.8 & 4.12):**
Let `B_-(φ, φ + δ)` have quadratic Taylor expansion `quadTaylor B_minus_0 dB_minus H δ`
where `B_minus_0 = 0`, `dB_minus = 0`, and `∂_ψ^2 B_-(φ,φ) = H` (Equation 4.4), and let
`B_0(φ, φ + δ)` have expansion `quadTaylor B0_0 dB0 d2B0 δ`. Substituting
`δ = ε * Ψ1 + ε^2 * Ψ2` into `2 * ε * E_d(ε) = 2 B_-(φ, φ+δ) + 2 ε B_0(φ, φ+δ) + 2 ε^2 B_1(φ,φ)`
and expanding in powers of `ε` proves:
1. The `O(ε^0)` term (corresponding to the `ε⁻¹` pole of `E_d(ε)`) vanishes identically;
2. The `O(ε^1)` term (corresponding to `2 Q_0`) equals `2 B_0(φ,φ)`;
3. The `O(ε^2)` term (corresponding to `2 Q_1`) equals
   `H * Ψ1^2 + 2 dB0 * Ψ1 + 2 B1_0`, where `H` is the second-derivative coefficient of
   `quadTaylor B_minus_0 dB_minus H` applied to `δ = ε * Ψ1 + ε^2 * Ψ2`. -/
theorem theorem_2_part_2_first_charge_density
    (B_minus_0 dB_minus H B0_0 dB0 d2B0 B1_0 Ψ1 Ψ2 ε : Int)
    (h_crit_val  : B_minus_0 = 0)
    (h_crit_grad : dB_minus = 0) :
    let δ := ε * Ψ1 + (ε * ε) * Ψ2
    let two_eps_Ed :=
      quadTaylor B_minus_0 dB_minus H δ +
      ε * quadTaylor B0_0 dB0 d2B0 (ε * Ψ1) +
      (ε * ε) * (2 * B1_0)
    let two_Q0 := 2 * B0_0
    let two_Q1 := H * (Ψ1 * Ψ1) + 2 * dB0 * Ψ1 + 2 * B1_0
    let higher_order_rem :=
      (ε * ε * ε) * (2 * H * Ψ1 * Ψ2 + d2B0 * (Ψ1 * Ψ1)) +
      (ε * ε * ε * ε) * (H * (Ψ2 * Ψ2))
    two_eps_Ed = 0 + ε * two_Q0 + (ε * ε) * two_Q1 + higher_order_rem := by
  intro δ two_eps_Ed two_Q0 two_Q1 higher_order_rem
  dsimp [two_eps_Ed, quadTaylor, δ, two_Q0, two_Q1, higher_order_rem]
  rw [h_crit_val, h_crit_grad]
  have h_sq :
      (ε * Ψ1 + ε * ε * Ψ2) * (ε * Ψ1 + ε * ε * Ψ2) =
      (ε * ε) * (Ψ1 * Ψ1) + (ε * ε * ε) * (Ψ1 * Ψ2) +
      (ε * ε * ε) * (Ψ1 * Ψ2) + (ε * ε * ε * ε) * (Ψ2 * Ψ2) := by
    have h_exp :
        (ε * Ψ1 + ε * ε * Ψ2) * (ε * Ψ1 + ε * ε * Ψ2) =
        (ε * Ψ1) * (ε * Ψ1) + (ε * Ψ1) * (ε * ε * Ψ2) +
        (ε * ε * Ψ2) * (ε * Ψ1) + (ε * ε * Ψ2) * (ε * ε * Ψ2) := by
      rw [Int.add_mul, Int.mul_add, Int.mul_add, ← Int.add_assoc]
    have t1 : (ε * Ψ1) * (ε * Ψ1) = (ε * ε) * (Ψ1 * Ψ1) := by
      rw [← Int.mul_assoc, Int.mul_assoc ε Ψ1 ε, Int.mul_comm Ψ1 ε, ← Int.mul_assoc, Int.mul_assoc]
    have t2 : (ε * Ψ1) * (ε * ε * Ψ2) = (ε * ε * ε) * (Ψ1 * Ψ2) := by
      rw [← Int.mul_assoc, ← Int.mul_assoc, Int.mul_assoc ε Ψ1 ε, Int.mul_comm Ψ1 ε,
          ← Int.mul_assoc, Int.mul_assoc (ε * ε) Ψ1 ε, Int.mul_comm Ψ1 ε,
          ← Int.mul_assoc, Int.mul_assoc]
    have t3 : (ε * ε * Ψ2) * (ε * Ψ1) = (ε * ε * ε) * (Ψ1 * Ψ2) := by
      rw [← Int.mul_assoc, Int.mul_assoc (ε * ε) Ψ2 ε, Int.mul_comm Ψ2 ε,
          ← Int.mul_assoc, Int.mul_assoc, Int.mul_comm Ψ2 Ψ1]
    have t4 : (ε * ε * Ψ2) * (ε * ε * Ψ2) = (ε * ε * ε * ε) * (Ψ2 * Ψ2) := by
      rw [← Int.mul_assoc, ← Int.mul_assoc, Int.mul_assoc (ε * ε) Ψ2 ε, Int.mul_comm Ψ2 ε,
          ← Int.mul_assoc, Int.mul_assoc (ε * ε * ε) Ψ2 ε, Int.mul_comm Ψ2 ε,
          ← Int.mul_assoc, Int.mul_assoc]
    rw [h_exp, t1, t2, t3, t4]
  have h_b0 :
      ε * (2 * B0_0 + 2 * dB0 * (ε * Ψ1) + d2B0 * ((ε * Ψ1) * (ε * Ψ1))) =
      ε * (2 * B0_0) + (ε * ε) * (2 * dB0 * Ψ1) + (ε * ε * ε) * (d2B0 * (Ψ1 * Ψ1)) := by
    have t1 : (ε * Ψ1) * (ε * Ψ1) = (ε * ε) * (Ψ1 * Ψ1) := by
      rw [← Int.mul_assoc, Int.mul_assoc ε Ψ1 ε, Int.mul_comm Ψ1 ε, ← Int.mul_assoc, Int.mul_assoc]
    have t2 : ε * (2 * dB0 * (ε * Ψ1)) = (ε * ε) * (2 * dB0 * Ψ1) := by
      rw [← Int.mul_assoc, ← Int.mul_assoc, Int.mul_assoc ε (2 * dB0) ε,
          Int.mul_comm (2 * dB0) ε, ← Int.mul_assoc, Int.mul_assoc (ε * ε)]
    have t3 : ε * (d2B0 * ((ε * ε) * (Ψ1 * Ψ1))) = (ε * ε * ε) * (d2B0 * (Ψ1 * Ψ1)) := by
      have c1 : d2B0 * ((ε * ε) * (Ψ1 * Ψ1)) = (ε * ε) * (d2B0 * (Ψ1 * Ψ1)) := by
        rw [← Int.mul_assoc, Int.mul_comm d2B0 (ε * ε), Int.mul_assoc]
      rw [c1, ← Int.mul_assoc, ← Int.mul_assoc ε ε ε]
    rw [t1, Int.mul_add, Int.mul_add, t2, t3]
  have h_H :
      H * ((ε * ε) * (Ψ1 * Ψ1) + (ε * ε * ε) * (Ψ1 * Ψ2) +
           (ε * ε * ε) * (Ψ1 * Ψ2) + (ε * ε * ε * ε) * (Ψ2 * Ψ2)) =
      (ε * ε) * (H * (Ψ1 * Ψ1)) + (ε * ε * ε) * (H * (Ψ1 * Ψ2)) +
      (ε * ε * ε) * (H * (Ψ1 * Ψ2)) + (ε * ε * ε * ε) * (H * (Ψ2 * Ψ2)) := by
    rw [Int.mul_add, Int.mul_add, Int.mul_add]
    have m1 : H * ((ε * ε) * (Ψ1 * Ψ1)) = (ε * ε) * (H * (Ψ1 * Ψ1)) := by
      rw [← Int.mul_assoc, Int.mul_comm H (ε * ε), Int.mul_assoc]
    have m2 : H * ((ε * ε * ε) * (Ψ1 * Ψ2)) = (ε * ε * ε) * (H * (Ψ1 * Ψ2)) := by
      rw [← Int.mul_assoc, Int.mul_comm H (ε * ε * ε), Int.mul_assoc]
    have m3 : H * ((ε * ε * ε * ε) * (Ψ2 * Ψ2)) = (ε * ε * ε * ε) * (H * (Ψ2 * Ψ2)) := by
      rw [← Int.mul_assoc, Int.mul_comm H (ε * ε * ε * ε), Int.mul_assoc]
    rw [m1, m2, m3]
  have h_two_H :
      2 * H * Ψ1 * Ψ2 = H * (Ψ1 * Ψ2) + H * (Ψ1 * Ψ2) := by
    have h2 : (2 : Int) = 1 + 1 := rfl
    rw [Int.mul_assoc (2 * H) Ψ1 Ψ2, h2, Int.add_mul, Int.one_mul, Int.add_mul]
  rw [h_sq, h_H, h_b0, h_two_H]
  repeat rw [Int.mul_add]
  omega

/-- **Theorem 2, Part 3 (Involution of Conserved Charges from Bianchi Permutability, Equation 4.13):**
Suppose:
1. `X (PB F G) = commutator (X F) (X G)` (Lie–Poisson homomorphism),
2. `{F, G} = dF (X G)` so that whenever `X G` vanishes at the vacuum (`evalAtVac (X G) = zeroVec`),
   `vacEval (PB F G) = dF_at_vac (evalAtVac (X G)) = 0`,
3. The Poisson structure has no non-constant local Casimirs on the vacuum-normalized charge space
   (`X H = zeroFlow → vacEval H = 0 → H = zeroCharge`),
4. For the hierarchy `Q n`, `evalAtVac (X (Q m)) = zeroVec` and `commutator (X (Q n)) (X (Q m)) = zeroFlow`.
Then `PB (Q n) (Q m) = zeroCharge` for all `n, m : Nat`. -/
theorem theorem_2_part_3_involution {Charge Flow Vec : Type}
    (zeroCharge : Charge) (zeroFlow : Flow) (zeroVec : Vec)
    (PB : Charge → Charge → Charge)
    (X : Charge → Flow)
    (commutator : Flow → Flow → Flow)
    (vacEval : Charge → Int)
    (evalAtVac : Flow → Vec)
    (dF_at_vac : Charge → Vec → Int)
    (h_jacobi    : ∀ F G : Charge, X (PB F G) = commutator (X F) (X G))
    (h_pb_vac    : ∀ F G : Charge, vacEval (PB F G) = dF_at_vac F (evalAtVac (X G)))
    (h_dF_zero   : ∀ F : Charge, dF_at_vac F zeroVec = 0)
    (h_no_casimir : ∀ H : Charge, X H = zeroFlow → vacEval H = 0 → H = zeroCharge)
    (Q : Nat → Charge)
    (h_X_vac     : ∀ m : Nat, evalAtVac (X (Q m)) = zeroVec)
    (h_bianchi   : ∀ n m : Nat, commutator (X (Q n)) (X (Q m)) = zeroFlow) :
    ∀ n m : Nat, PB (Q n) (Q m) = zeroCharge := by
  intro n m
  apply h_no_casimir (PB (Q n) (Q m))
  · rw [h_jacobi (Q n) (Q m)]
    exact h_bianchi n m
  · rw [h_pb_vac (Q n) (Q m), h_X_vac m, h_dF_zero (Q n)]

/-!
## 5. Concrete Model Verifications (Section 4.3 Example & Section 5)
-/

/-- **Section 4.3 Example (Bowcock–Corrigan–Zambon Free Massive Scalar Defect [1, 2]):**
For `L = 1/2 (dt φ)^2 - 1/2 (dx φ)^2 - 1/2 m^2 φ^2` and
`L_d = 1/2 (φ dt ψ - ψ dt φ) - (φ - ψ)^2 / (2 ε) - ε m^2 / 8 (φ + ψ)^2`:
1. The `O(ε^0)` first sewing equation `-dx φ = -dt φ - Ψ1` uniquely determines `Ψ1 = dx φ - dt φ`;
2. Applying `quadTaylor` to `B_±(φ, φ + ε Ψ1) = (ε Ψ1)^2 / (2 ε) ± ε m^2 / 8 (2 φ + ε Ψ1)^2`
   extracts `2 Q_1 = (dx φ - dt φ)^2 + m^2 φ^2` from `E_d` and
   `2 J_1 = (dx φ - dt φ)^2 - m^2 φ^2` from `P_d`;
3. Using the Leibniz product rule (`hD.leibniz_t`, `hD.leibniz_x'`) and `hD.comm`,
   `dt (2 Q_1) + dx (2 J_1) = 2 (dt φ - dx φ) (dt (dt φ) - dx (dx φ) + m^2 φ)`,
   which vanishes on every solution of the Klein–Gordon equation `dt (dt φ) - dx (dx φ) + m^2 φ = 0`,
   whereas omitting the `B_1(φ,φ)` mass term `m^2 φ^2` leaves the non-zero residual
   `-(2 * m^2 * φ * (dt φ - dx φ))`. -/
theorem example_free_massive_scalar_Q1_conservation
    (dt dx : Int → Int) (hD : SpaceTimeDerivations dt dx)
    (φ m2 Ψ1 : Int)
    (h_dt_m2 : dt m2 = 0) (h_dx_m2 : dx m2 = 0)
    -- O(ε^0) sewing equation `-dx φ = -dt φ - Ψ1`:
    (h_sew0 : -dx φ = -dt φ - Ψ1) :
    let two_Q1 := Ψ1 * Ψ1 + m2 * (φ * φ)
    let two_J1 := Ψ1 * Ψ1 - m2 * (φ * φ)
    let two_Q1_no_B1 := Ψ1 * Ψ1
    -- 1. Ψ1 is uniquely determined as dx φ - dt φ:
    (Ψ1 = dx φ - dt φ) ∧
    -- 2. Full conservation law derived via the Leibniz rule:
    (dt two_Q1 + dx two_J1 = 2 * (dt φ - dx φ) * (dt (dt φ) - dx (dx φ) + m2 * φ)) ∧
    -- 3. On-shell conservation (`dt (dt φ) - dx (dx φ) + m2 * φ = 0`):
    (dt (dt φ) - dx (dx φ) + m2 * φ = 0 → dt two_Q1 + dx two_J1 = 0) ∧
    -- 4. Omitting B1(φ,φ) = 1/2 m^2 φ^2 breaks on-shell conservation by `-(2 * m^2 * φ * (dt φ - dx φ))`:
    (dt (dt φ) - dx (dx φ) + m2 * φ = 0 →
      dt two_Q1_no_B1 + dx two_J1 = -(2 * m2 * φ * (dt φ - dx φ) + dx (m2 * (φ * φ)))) := by
  intro two_Q1 two_J1 two_Q1_no_B1
  have hΨ1 : Ψ1 = dx φ - dt φ := by omega
  have h_dt_Ψ1_sq :
      dt (Ψ1 * Ψ1) = 2 * (dx φ - dt φ) * (dx (dt φ) - dt (dt φ)) := by
    rw [hD.leibniz_t Ψ1 Ψ1, hΨ1, hD.map_sub_t, hD.comm φ]
    have h_add :
        (dx (dt φ) - dt (dt φ)) * (dx φ - dt φ) + (dx φ - dt φ) * (dx (dt φ) - dt (dt φ)) =
        2 * (dx φ - dt φ) * (dx (dt φ) - dt (dt φ)) := by
      rw [Int.mul_comm (dx (dt φ) - dt (dt φ)) (dx φ - dt φ), ← Int.add_mul]
      have h2 : (dx φ - dt φ) + (dx φ - dt φ) = 2 * (dx φ - dt φ) := by omega
      rw [h2]
    exact h_add
  have h_dx_Ψ1_sq :
      dx (Ψ1 * Ψ1) = 2 * (dx φ - dt φ) * (dx (dx φ) - dx (dt φ)) := by
    rw [hD.leibniz_x' Ψ1 Ψ1, hΨ1, hD.map_sub_x]
    have h_add :
        (dx (dx φ) - dx (dt φ)) * (dx φ - dt φ) + (dx φ - dt φ) * (dx (dx φ) - dx (dt φ)) =
        2 * (dx φ - dt φ) * (dx (dx φ) - dx (dt φ)) := by
      rw [Int.mul_comm (dx (dx φ) - dx (dt φ)) (dx φ - dt φ), ← Int.add_mul]
      have h2 : (dx φ - dt φ) + (dx φ - dt φ) = 2 * (dx φ - dt φ) := by omega
      rw [h2]
    exact h_add
  have h_dt_mass : dt (m2 * (φ * φ)) = 2 * (dt φ) * (m2 * φ) := by
    rw [hD.map_const_mul_t m2 (φ * φ) h_dt_m2, hD.leibniz_t φ φ]
    have h_two : dt φ * φ + φ * dt φ = 2 * dt φ * φ := by
      rw [Int.mul_comm φ (dt φ), ← Int.add_mul]
      have h2 : dt φ + dt φ = 2 * dt φ := by omega
      rw [h2]
    rw [h_two, ← Int.mul_assoc, Int.mul_comm m2 (2 * dt φ), Int.mul_assoc]
  have h_dx_mass : dx (m2 * (φ * φ)) = 2 * (dx φ) * (m2 * φ) := by
    rw [hD.map_const_mul_x m2 (φ * φ) h_dx_m2, hD.leibniz_x' φ φ]
    have h_two : dx φ * φ + φ * dx φ = 2 * dx φ * φ := by
      rw [Int.mul_comm φ (dx φ), ← Int.add_mul]
      have h2 : dx φ + dx φ = 2 * dx φ := by omega
      rw [h2]
    rw [h_two, ← Int.mul_assoc, Int.mul_comm m2 (2 * dx φ), Int.mul_assoc]
  have h_kin_sum :
      2 * (dx φ - dt φ) * (dx (dt φ) - dt (dt φ)) +
      2 * (dx φ - dt φ) * (dx (dx φ) - dx (dt φ)) =
      2 * (dt φ - dx φ) * (dt (dt φ) - dx (dx φ)) := by
    rw [← Int.mul_add]
    have h_sub : (dx (dt φ) - dt (dt φ)) + (dx (dx φ) - dx (dt φ)) = -(dt (dt φ) - dx (dx φ)) := by omega
    have h_neg : 2 * (dx φ - dt φ) = -(2 * (dt φ - dx φ)) := by omega
    rw [h_sub, h_neg, Int.neg_mul_neg]
  have h_mass_diff :
      2 * (dt φ) * (m2 * φ) - 2 * (dx φ) * (m2 * φ) =
      2 * (dt φ - dx φ) * (m2 * φ) := by
    rw [← Int.sub_mul]
    have h2 : 2 * dt φ - 2 * dx φ = 2 * (dt φ - dx φ) := by omega
    rw [h2]
  have h_full :
      dt two_Q1 + dx two_J1 = 2 * (dt φ - dx φ) * (dt (dt φ) - dx (dx φ) + m2 * φ) := by
    dsimp [two_Q1, two_J1]
    rw [hD.map_add_t, hD.map_sub_x, h_dt_Ψ1_sq, h_dx_Ψ1_sq, h_dt_mass, h_dx_mass]
    rw [Int.mul_add, ← h_kin_sum, ← h_mass_diff]
    omega
  refine ⟨hΨ1, h_full, ?_, ?_⟩
  · intro h_kg
    rw [h_full, h_kg, Int.mul_zero]
  · intro h_kg
    dsimp [two_Q1_no_B1, two_J1]
    rw [hD.map_sub_x, h_dt_Ψ1_sq, h_dx_Ψ1_sq]
    have h_kg_sub : dt (dt φ) - dx (dx φ) = -(m2 * φ) := by omega
    have h_prod : 2 * (dt φ - dx φ) * (m2 * φ) = 2 * m2 * φ * (dt φ - dx φ) := by
      rw [← Int.mul_assoc, Int.mul_comm (2 * (dt φ - dx φ)) m2, ← Int.mul_assoc,
          Int.mul_comm m2 2, Int.mul_assoc (2 * m2) (dt φ - dx φ) φ,
          Int.mul_comm (dt φ - dx φ) φ, ← Int.mul_assoc]
    have h_kin_on_shell :
        2 * (dx φ - dt φ) * (dx (dt φ) - dt (dt φ)) +
        2 * (dx φ - dt φ) * (dx (dx φ) - dx (dt φ)) =
        -(2 * m2 * φ * (dt φ - dx φ)) := by
      rw [h_kin_sum, h_kg_sub, Int.mul_neg, h_prod]
    omega

/-- **Section 5.1 (Equation 5.1): Relativistic Scalar Spatial Hamiltonian Identity.**
For `2 L = φ_t^2 - φ_x^2 - 2 U(φ)`, the spatial momentum is `π^(x) = -φ_x`, the momentum
flux is `2 T^11 = φ_t^2 + φ_x^2 - 2 U(φ)`, and the spatial Hamiltonian density satisfies
`2 H^(x) = -2 T^11 = -(π^(x))^2 - φ_t^2 + 2 U(φ)`. -/
theorem section_5_1_relativistic_spatial_hamiltonian (φ_t φ_x U : Int) :
    let two_L   := φ_t * φ_t - φ_x * φ_x - 2 * U
    let π_x     := -φ_x
    let two_H_x := 2 * (π_x * φ_x) - two_L
    let two_T11 := φ_t * φ_t + φ_x * φ_x - 2 * U
    two_H_x = -two_T11 ∧
    two_H_x = -(π_x * π_x) - φ_t * φ_t + 2 * U := by
  intro two_L π_x two_H_x two_T11
  dsimp [two_H_x, two_T11, two_L, π_x]
  have h_sq : (-φ_x) * φ_x = -(φ_x * φ_x) := by rw [Int.neg_mul]
  have h_sq2 : (-φ_x) * (-φ_x) = φ_x * φ_x := by rw [Int.neg_mul_neg]
  omega

/-- **Section 5.1 (Chiral Bäcklund Intertwining of the Bulk Wave Equations):**
Along the promoted chiral defect relations where eliminating the mixed derivative `∂_t ∂_x ψ`
yields the single second-order compatibility identity `□φ - □ψ = -(U_φ - V_ψ)`, the left bulk
wave equation `□φ + U_φ = 0` holds if and only if the right bulk wave equation `□ψ + V_ψ = 0`
holds (without forcing either wave equation to hold off-shell). -/
theorem section_5_1_chiral_backlund_equivalence
    (box_φ box_ψ U_φ V_ψ : Int)
    (h_compat : box_φ - box_ψ = -(U_φ - V_ψ)) :
    box_φ + U_φ = 0 ↔ box_ψ + V_ψ = 0 := by
  omega

/-- **Section 5.2 (NLS Particle-Number Current and Defect Continuity Equation):**
Decomposing the complex NLS field `u = u1 + i u2` into real and imaginary parts, the Lagrangian
`L_- = 1/2 (i (ū u_t - u ū_t)) - |u_x|^2 - V(|u|^2) = (u2 * dt u1 - u1 * dt u2) - ((dx u1)^2 + (dx u2)^2) - V`
has Euler–Lagrange equations `dt u1 = -dx (dx u2) + V' * u2` and `dt u2 = dx (dx u1) - V' * u1`.
Using the Leibniz product rule (`hD.leibniz_t`, `hD.leibniz_x'`), we prove:
1. The particle-number density `N = |u|^2 = u1^2 + u2^2` and spatial flux
   `J_N = -i (ū u_x - u ū_x) = 2 (u1 * dx u2 - u2 * dx u1)` satisfy the exact on-shell
   continuity equation `dt N + dx J_N = 0`;
2. Since the canonical momentum density is `T^01 = -i/2 (ū u_x - u ū_x) = u1 * dx u2 - u2 * dx u1`,
   the flux proportionality constant is `c = +2` (`J_N = +2 * T^01`);
3. By Proposition 4.1 (`dt N_d = J_{N,-} - J_{N,+}` and `dx P_d = -(T_-^01 - T_+^01)`),
   the defect particle-number density `N_d` and defect momentum `P_d` satisfy
   `dt N_d + 2 * dx P_d = 0`. -/
theorem section_5_2_nls_number_current
    (dt dx : Int → Int) (hD : SpaceTimeDerivations dt dx)
    (u1 u2 V_prime N_d P_d T_minus_01 T_plus_01 JN_minus JN_plus : Int)
    -- Real and imaginary parts of the NLS equation `i u_t + u_xx - V'(|u|^2) u = 0`:
    (h_nls_1 : dt u1 = -dx (dx u2) + V_prime * u2)
    (h_nls_2 : dt u2 =  dx (dx u1) - V_prime * u1)
    -- Defect balance relations from Proposition 4.1:
    (h_dt_Nd : dt N_d = JN_minus - JN_plus)
    (h_dx_Pd : dx P_d = -(T_minus_01 - T_plus_01))
    (h_JNm   : JN_minus = 2 * T_minus_01)
    (h_JNp   : JN_plus  = 2 * T_plus_01) :
    let N   := u1 * u1 + u2 * u2
    let T01 := u1 * dx u2 - u2 * dx u1
    let J_N := 2 * (u1 * dx u2 - u2 * dx u1)
    J_N = 2 * T01 ∧
    dt N + dx J_N = 0 ∧
    dt N_d + 2 * dx P_d = 0 := by
  intro N T01 J_N
  refine ⟨rfl, ?_, ?_⟩
  · dsimp [N, J_N]
    have h_dx_2 : dx 2 = 0 := by
      have h1 := hD.map_one_x
      have ha := hD.map_add_x 1 1
      have h2 : (1 : Int) + 1 = 2 := rfl
      rw [h2, h1] at ha
      exact ha
    rw [hD.map_add_t, hD.leibniz_t u1 u1, hD.leibniz_t u2 u2,
        hD.map_const_mul_x 2 (u1 * dx u2 - u2 * dx u1) h_dx_2,
        hD.map_sub_x, hD.leibniz_x' u1 (dx u2), hD.leibniz_x' u2 (dx u1),
        h_nls_1, h_nls_2]
    have c1 : (-dx (dx u2) + V_prime * u2) * u1 = u1 * (-dx (dx u2) + V_prime * u2) := by
      rw [Int.mul_comm]
    have c2 : (dx (dx u1) - V_prime * u1) * u2 = u2 * (dx (dx u1) - V_prime * u1) := by
      rw [Int.mul_comm]
    have c3 : u1 * (-dx (dx u2) + V_prime * u2) = -(u1 * dx (dx u2)) + u1 * (V_prime * u2) := by
      rw [Int.mul_add, Int.mul_neg]
    have c4 : u2 * (dx (dx u1) - V_prime * u1) = u2 * dx (dx u1) - u2 * (V_prime * u1) := by
      rw [Int.mul_sub]
    have c5 : u1 * (V_prime * u2) = u2 * (V_prime * u1) := by
      rw [← Int.mul_assoc, Int.mul_comm u1 V_prime, Int.mul_assoc,
          Int.mul_comm u1 u2, ← Int.mul_assoc, Int.mul_comm V_prime u2, Int.mul_assoc]
    have c6 : dx u1 * dx u2 = dx u2 * dx u1 := by rw [Int.mul_comm]
    rw [c1, c2, c3, c4, c5, c6]
    omega
  · rw [h_dt_Nd, h_JNm, h_JNp, h_dx_Pd]
    omega

end DefectIntegrability
